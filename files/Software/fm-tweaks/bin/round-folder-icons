#!/usr/bin/env python3
"""round-folder-icons - round the top-right and both BOTTOM corners (same radius) of the white folder icon, and make it square (40x40 instead of 40x37; --no-square to skip), (the Papirus-style one swapped into MacTahoe-nord-dark).

The theme's real folder files are places/{16,22,24,scalable}/folder.svg (and the same under places@2x); every other folder-ish name that resolves to
them (inode-directory, default-folder-*, ...) is a symlink. This script writes rounded replacements for those 4(+4) files and recreates every such
symlink next to them, into a user-owned overlay of the same theme name (~/.local/share/icons/<theme>), which GTK/Qt search BEFORE /usr/share/icons.
No root needed. To change the system files in place instead:  sudo cp -a ~/.local/share/icons/<theme>/. /usr/share/icons/<theme>/
Colored variants (folder-blue, folder-code, ...) have a different design and are left alone.

usage: round-folder-icons [--theme MacTahoe-nord-dark] [--radius 6] [--dest DIR]   (radius is in 48-unit icon space; scaled per size)
"""
import os, re, sys, argparse
ap = argparse.ArgumentParser()
ap.add_argument('--theme', default='MacTahoe-nord-dark')
ap.add_argument('--radius', type=float, default=6.0)
ap.add_argument('--no-square', dest='square', action='store_false', help='keep the original 40x37 proportions')
ap.add_argument('--dest', default=None)
a = ap.parse_args()
SRC = '/usr/share/icons/' + a.theme
DST = a.dest or os.path.expanduser('~/.local/share/icons/' + a.theme)
if not os.path.isdir(SRC):
    sys.exit('no such theme: ' + SRC)

def f(v):
    return ('%.3f' % v).rstrip('0').rstrip('.')

def panel(x, y, w, h, rtl, rtr, rb):
    """rounded rect with separate top-left / top-right / bottom radii"""
    return ('M %s,%s A %s,%s 0 0 1 %s,%s H %s A %s,%s 0 0 1 %s,%s V %s A %s,%s 0 0 1 %s,%s H %s A %s,%s 0 0 1 %s,%s Z' % (
        f(x), f(y + rtl), f(rtl), f(rtl), f(x + rtl), f(y), f(x + w - rtr), f(rtr), f(rtr), f(x + w), f(y + rtr),
        f(y + h - rb), f(rb), f(rb), f(x + w - rb), f(y + h), f(x + rb), f(rb), f(rb), f(x), f(y + h - rb)))

def design(svg, size, r, square):
    """the 48-unit scalable folder: front panel + its 2 shadow layers get top-right AND both bottom corners of radius r (top-left stays 2, the tab side);
    the back layer's / highlight's top-right corner follows; the paper sheet is narrowed so it stays inside the rounded corner. With square=True the artwork (40 wide x 37 tall) is
    stretched vertically to 40x40. The same design is written for every size dir (the old per-size hand-tuned art is replaced)."""
    def sub(m):
        t = m.group(0)
        g = lambda k: float(re.search(r'\b%s="([^"]+)"' % k, t).group(1))
        st = re.search(r'style="([^"]*)"', t).group(1)
        if abs(g('width') - 40) < 1e-6 and abs(g('height') - 26) < 1e-6:
            return '<path style="%s" d="%s"/>' % (st, panel(g('x'), g('y'), 40, 26, 2, r, r))
        if abs(g('width') - 36) < 1e-6 and abs(g('height') - 16) < 1e-6:
            return '<rect style="%s" width="%s" height="16" x="6" y="13" rx="2" ry="2"/>' % (st, f(44 - r - 6))
        return t
    svg = re.sub(r'<rect\b[^>]*/>', sub, svg)
    old_back = 'V 12 C 44,10.892 43.108,10 42,10 H 24'
    new_back = 'V %s A %s,%s 0 0 0 %s,10 H 24' % (f(10 + r), f(r), f(r), f(44 - r))
    assert svg.count(old_back) == 2, 'unexpected folder.svg source'
    svg = svg.replace('H 42 C 43.108,11 44,11.892 44,13 ' + old_back, 'H %s A %s,%s 0 0 1 44,%s ' % (f(44 - r), f(r), f(r), f(11 + r)) + new_back)   # highlight strip
    svg = svg.replace(old_back, new_back)                                                                                                                  # back layer
    head, body = svg.split('>', 1)
    body = body.rsplit('</svg>', 1)[0]
    if square:
        k = 40.0 / 37.0; body = '<g transform="translate(0,%s) scale(1,%s)">%s</g>\n' % (f(4 - 6 * k), f(k), body)
    n = 48 if size == 'scalable' else int(size)
    return '<svg xmlns="http://www.w3.org/2000/svg" width="%d" height="%d" viewBox="0 0 48 48" version="1">%s</svg>\n' % (n, n, body)

os.makedirs(DST, exist_ok=True)
written = linked = 0
# 1. the real files
real = {}
for top in ('places', 'places@2x'):
    sp = os.path.join(SRC, top, 'scalable', 'folder.svg')
    if not os.path.isfile(sp):
        continue
    src = open(sp).read()
    for size in ('16', '22', '24', 'scalable'):
        out = os.path.join(DST, top, size, 'folder.svg')
        os.makedirs(os.path.dirname(out), exist_ok=True)
        open(out, 'w').write(design(src, size, a.radius, a.square))
        real[(top, size)] = out
        written += 1
# 2. every symlink in the theme that resolves to a places/<size>/folder.svg (any theme: this theme's mimes/ and actions/ dirs are themselves links into the
#    sibling MacTahoe-nord) -> the same relative link in the overlay, pointing at the rounded file of the same size. Lookups by ANY of those names then hit it.
for root, dirs, files in os.walk(SRC, followlinks=True):
    for n in files:
        p = os.path.join(root, n)
        if not os.path.islink(p):
            continue
        parts = os.path.realpath(p).split('/')
        key = (parts[-3], parts[-2]) if len(parts) > 3 and parts[-1] == 'folder.svg' else None
        if key not in real:
            continue
        rel = os.path.relpath(p, SRC)
        out = os.path.join(DST, rel)
        os.makedirs(os.path.dirname(out), exist_ok=True)
        if os.path.lexists(out):
            os.remove(out)
        os.symlink(os.path.relpath(real[key], os.path.dirname(out)), out)
        linked += 1
print('wrote %d folder.svg, %d symlinks -> %s' % (written, linked, DST))
