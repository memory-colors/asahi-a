    ('smplayer', 'smdisabled', '', 'color?', 'SMPlayer greyed-out text (empty = smtext minus 70)'),
    ('smplayer', 'smcontrolicon', '', 'color?', 'SMPlayer main control bar icons (empty = icons stay as shipped)'),
    ('smplayer', 'smfloaticon', '', 'color?', 'SMPlayer floating control bar icons (empty = icons stay as shipped)'),
    ('thunar', 'inactivetext', '0.53',  'float',  'Thunar: opacity of the inactive split pane (lower = dimmer)'),
]
BYKEY = {k[1]: k for k in KEYS}
HEX = re.compile(r'^#?([0-9a-fA-F]{6})$')

# Fixed look relationships (one set for every machine; per-machine differences come from the base colors in the conf)
D_BUTTON = (-6, -6, -8)     # column-header row = view + this
D_TIPBORDER = (18, 18, 18)  # tooltip border = tooltip + this
D_DIVIDER = (7, 7, 8)       # Thunar pane dividers = view + this
D_ACCENT_HOVER = (18, 8, 21)  # Thunar default-dialog-button hover = accent + this

def shift(h, d):
    return ''.join('%02x' % max(0, min(255, int(h[i:i + 2], 16) + d[i // 2])) for i in (0, 2, 4))

def dec(h):
    return '%d,%d,%d' % (int(h[0:2], 16), int(h[2:4], 16), int(h[4:6], 16))

# ---------------------------------------------------------------- conf
def parse_value(key, raw):
    kind = BYKEY[key][3]
    raw = raw.strip()
    if kind in ('bool', 'text'):
        raw = re.split(r'\s+#', raw, maxsplit=1)[0].strip()
        if kind == 'bool' and raw.lower() not in ('true', 'false'):
            sys.exit('fm-tweaks: %s must be true or false, got %r' % (key, raw))
        return raw.lower() if kind == 'bool' else raw
    if kind == 'float':
        m = re.match(r'^[0-9]*\.?[0-9]+', raw)
        if not m:
            sys.exit('fm-tweaks: %s must be a number, got %r' % (key, raw))
        return m.group(0)
    m = re.match(r'^#?([0-9a-fA-F]{6})(?:\s|$)', raw)
    if m:
        return m.group(1).lower()
    if kind == 'color?' and re.match(r'^(#(\s|$)|$)', raw):   # empty: a following `# comment` is not a value
        return ''
    sys.exit('fm-tweaks: bad value for %s: %r' % (key, raw))

def read_conf():
    vals = {k[1]: k[2] for k in KEYS}                # defaults fill whatever the conf doesn't say
    if os.path.exists(CONF):
        for ln in open(CONF).read().split('\n'):
            m = re.match(r'^\s*([a-z]+)\s*=\s*(.*)$', ln)
            if m and not ln.lstrip().startswith('#') and m.group(1) in BYKEY:
                vals[m.group(1)] = parse_value(m.group(1), m.group(2)) if m.group(2).strip() else (vals[m.group(1)] if BYKEY[m.group(1)][3] != 'color?' else '')
    return vals

SM_FOLLOW = {'smmenu': 'tooltip', 'smpanel': 'window', 'smcontent': 'view', 'smfield': 'button', 'smaccent': 'accent', 'smstatus': 'statusbar', 'smtext': 'text', 'smstatustext': 'statustext', 'smhltext': 'hltext',
             'smplaylisttext': 'smtext', 'smcontrol': 'smpanel', 'smcontrolknob': 'smtext', 'smfloat': 'smpanel', 'smfloattext': 'smtext', 'smfloatknob': 'smtext', 'smmenuhltext': 'smhltext'}

def effective(v):
    e = dict(v)
    e['statusbar'] = v['statusbar'] or v['view']
    e['button'] = v['button'] or shift(v['view'], D_BUTTON)
    e['sidebarhl'] = v['sidebarhl'] or v['accent']
    e['rowhovercss'] = ('#' + v['rowhover']) if v['rowhover'] else 'alpha(#%s, 0.5)' % v['accent']   # what the CSS gets: a solid colour, or the translucent accent (unchanged look)
    e['rowhover'] = v['rowhover'] or ''.join('%02x' % ((int(v['accent'][i:i + 2], 16) + int(v['view'][i:i + 2], 16)) // 2) for i in (0, 2, 4))   # `get` shows the colour as seen on the view: the 50% mix
    e['titlebar'] = v['titlebar'] or e['button']
    e['menubar'] = v['menubar'] or v['tooltip']
    e['headertext'] = v['headertext'] or v['text']
    e['smheadertext'] = v['smheadertext'] or v['smtext'] or v['buttontext']   # = what SMPlayer's headers used before they had their own swatch
    for k, follow in SM_FOLLOW.items():
        e[k] = v[k] or e[follow]
    e['smmenuborder'] = v['smmenuborder'] or '45454d'
    e['smborder'] = v['smborder'] or shift(e['smmenu'], D_TIPBORDER)
    e['smdisabled'] = v['smdisabled'] or shift(e['smtext'], (-70, -70, -70))
    # the generic names the shared templates use; sm_view swaps them for the sm* keys above
    e.update(playlisttext=e['text'], controlbg=e['window'], controlknob=e['text'], floatbg=e['window'], floattext=e['text'], floatknob=e['text'],
             menuhltext='ffffff', menuborder='45454d', borderc=shift(e['tooltip'], D_TIPBORDER), disabledc=shift(e['text'], (-70, -70, -70)))
    return e

def write_conf_keys(changes):
    """apply {key: value} to the conf text in memory, then write ONCE (all-or-nothing); creates the conf from the defaults when missing"""
    text = open(CONF).read() if os.path.exists(CONF) else conf_text()
    for key, val in changes.items():
        shown = ('#' + val) if BYKEY[key][3] in ('color', 'color?') and val else val
        # exactly one space on each side of the value so it can never fuse with the trailing `# comment`
        text, n = re.subn(r'(?m)^([ \t]*%s[ \t]*=)[ \t]*(?:#?[0-9a-fA-F]{6}\b|[0-9]*\.?[0-9]+\b|true\b|false\b|[A-Za-z+]+(?=[ \t]|$))?[ \t]*' % re.escape(key),
                          lambda m: m.group(1) + ' ' + shown + ' ', text, count=1)
        if n == 0:   # a key added in a newer version: append it to its section (or create the section)
            sec, _, _, kind, doc = BYKEY[key][0], 0, 0, BYKEY[key][3], BYKEY[key][4]
            line = '%-12s = %s  # %s' % (key, shown, doc)
            m = re.search(r'(?ms)^\[%s\][ \t]*\n(.*?)(?=^\[|\Z)' % re.escape(sec), text)
            if m:
                body = m.group(1).rstrip('\n')
                text = text[:m.start(1)] + body + ('\n' if body else '') + line + '\n\n' + text[m.end(1):].lstrip('\n')
            else:
                text = text.rstrip('\n') + '\n\n[%s]\n%s\n' % (sec, line)
    atomic_write(CONF, text)

def conf_text():
    out = ['# fm-tweaks.conf - the single source of truth for the Thunar / SMPlayer / Qt app look. Edit here, or: fm-tweaks set <key> <value>.',
           '# `fm-tweaks apply` regenerates every output (Knomadic rows do it via fm-color.sh). Restart Thunar / the app to see changes.', '']
    sec = None
    for s, k, d, kind, doc in KEYS:
        if s != sec:
            out += ['[%s]' % s]
            sec = s
        val = ('#' + d if d and kind in ('color', 'color?') else d)
        out.append('%-12s = %-8s  # %s' % (k, val, doc))
        if k in ('statustext', 'statusbar', 'tooltip'):
            out.append('')
    return '\n'.join(out) + '\n'

# ---------------------------------------------------------------- templates -> outputs
def atomic_write(path, text):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    tmp = path + '.tmp-fm-tweaks'
    with open(tmp, 'w') as f:
        f.write(text)
    if os.path.exists(path):
        os.chmod(tmp, os.stat(path).st_mode & 0o777)
    os.replace(tmp, path)

def tokens(e):
    v = e['view']
    t = {k: '#' + e[k] for k in ('sidebar', 'view', 'accent', 'window', 'tooltip', 'menubar', 'statusbar',
                                 'text', 'sidebartext', 'buttontext', 'statustext', 'button', 'sidebarhl', 'hltext', 'titlebar', 'headertext',
                                 'playlisttext', 'controlbg', 'controlknob', 'floatbg', 'floattext', 'floatknob', 'menuhltext', 'menuborder')}
    t['inactivetext'] = e['inactivetext']
    t['rowhover'] = e['rowhovercss']
    # Thunar paints the file-view selection as accent_bg_color at 50% alpha over the view colour: accent_paint = 2*accent - view (clamped), so it lands on the swatch
    t['accent_paint'] = '#' + ''.join('%02x' % max(0, min(255, 2 * int(e['accent'][i:i + 2], 16) - int(e['view'][i:i + 2], 16))) for i in (0, 2, 4))
    t['divider'] = '#' + shift(v, D_DIVIDER)
    t['accent_hover'] = '#' + shift(e['accent'], D_ACCENT_HOVER)
    t['tipborder'] = '#' + e['borderc']
    for k in ('view', 'window', 'accent', 'text', 'buttontext'):
        t[k + '_dec'] = dec(e[k])
    t['button_dec'] = dec(e['button'])
    t['asset_dir'] = os.path.dirname(SMPLAYER_QSS)
    t['text_dim'] = '#' + e['disabledc']
    return t

def sm_view(e, v):
    """the colour set SMPlayer is rendered from: every swatch the shared SMPlayer templates use is replaced by its own sm* key (which follows the main one until set)"""
    s = dict(e)
    s.update(tooltip=e['smmenu'], window=e['smpanel'], view=e['smcontent'], button=e['smfield'], accent=e['smaccent'], statusbar=e['smstatus'],
             text=e['smtext'], buttontext=v['smtext'] or e['buttontext'], statustext=e['smstatustext'], hltext=e['smhltext'], headertext=e['smheadertext'],
             playlisttext=e['smplaylisttext'], controlbg=e['smcontrol'], controlknob=e['smcontrolknob'], floatbg=e['smfloat'], floattext=e['smfloattext'],
             floatknob=e['smfloatknob'], menuhltext=e['smmenuhltext'], menuborder=e['smmenuborder'], borderc=e['smborder'], disabledc=e['smdisabled'])
    return s

def qt_svgs(e):
    """tiny glyphs the SMPlayer stylesheet needs (QSS can't draw arrows / check marks): coloured from the swatches"""
    x = '#' + e['buttontext']; hl = '#' + e['hltext']
    head = '<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 16 16">'
    return {'arrow-down.svg': head + '<path d="M4 6l4 4 4-4" fill="none" stroke="%s" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>' % x,
            'arrow-up.svg': head + '<path d="M4 10l4-4 4 4" fill="none" stroke="%s" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>' % x,
            'check.svg': head + '<path d="M3.5 8.5l3 3 6-6.5" fill="none" stroke="%s" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>' % hl,
            'radio.svg': head + '<circle cx="8" cy="8" r="3" fill="%s"/></svg>' % hl}

def qt_theme_conf(e, t, font=None):
    """palette for the qt-fm shim, role order = QPalette::ColorRole 0..21"""
    a = lambda h, al='ff': '#' + al + h.lstrip('#')
    w, text = e['window'], e['text']
    def roles(dis):
        tx = (lambda h: a(h, '80')) if dis else (lambda h: a(h))
        return [tx(text), a(e['button']), a(shift(w, (40, 40, 44))), a(shift(w, (20, 20, 22))), a(shift(w, (-22, -22, -24))), a(shift(w, (-12, -12, -13))), tx(text), a('ffffff'), tx(e['buttontext']),
                a(e['view']), a(w), a('000000'), a(e['accent']), a(e['hltext']), a(shift(e['accent'], (60, 60, 70))), a(shift(e['accent'], (30, 20, 50))), a(shift(e['view'], (6, 6, 8))),
                a(w), a(e['tooltip']), a(text), a(text, '70'), a(e['accent'])]
    return '# GENERATED by fm-tweaks (qt_theme_conf) - read by ~/.themes/qt-fm/libqt-fm.so\n[colors]\nactive=%s\ninactive=%s\ndisabled=%s\n\n%s[icons]\ntheme=%s\n\n[ui.smplayer]\nmenubar_hidden=%s\nmenubar_key=%s\nhide_dock_titles=%s\nhide_logo=%s\nhide_playlist_toolbar=%s\nplaylist_number_col_width=%s\ncontrol_icon_color=%s\nfloating_icon_color=%s\n' % (', '.join(roles(False)), ', '.join(roles(False)), ', '.join(roles(True)), ('[fonts]\ngeneral=%s\n\n' % font if font else ''), QT_ICON_THEME, e['menubar_hidden'], e['menubar_key'], e['hide_dock_titles'], e['hide_logo'], e['hide_playlist_toolbar'], e['playlist_number_col_width'], ('#' + e['smcontrolicon']) if e['smcontrolicon'] else '', ('#' + e['smfloaticon']) if e['smfloaticon'] else '')

def render(name, t):
    text = open(os.path.join(TEMPLATES, name)).read()
    missing = set(re.findall(r'\{\{(\w+)\}\}', text)) - set(t)
    if missing:
        sys.exit('fm-tweaks: template %s uses unknown token(s): %s' % (name, ', '.join(sorted(missing))))
    return re.sub(r'\{\{(\w+)\}\}', lambda m: t[m.group(1)], text)

FOLDER_FILL = re.compile(r'style="fill:#([0-9a-f]{6})"')   # exactly three in bin/round-folder-icons' design, in this order: back layer, paper, front panel (the white highlight has opacity first, so it never matches)

def folder_icon_files():
    f = [os.path.join(ICON_DIR, 'fm-folders/folder.svg'), os.path.join(ICON_DIR, 'fm-folders/places/scalable/folder.svg')]
    for top in ('places', 'places@2x'):
        for size in ('16', '22', '24', 'scalable'):
            f.append(os.path.join(ICON_DIR, 'MacTahoe-nord-dark', top, size, 'folder.svg'))
    return [p for p in f if os.path.isfile(p) and not os.path.islink(p)]

# PNG-based folder (Debian's lt_grey_final.png wrapped in an SVG): its dominant colour, so the tint maps that colour to the swatch colour and keeps the shading
FOLDER_PNG_REF = (224, 236, 240)
def tint_png_folder(s, color):
    f = ' '.join('%.4f' % (int(color[i:i + 2], 16) / FOLDER_PNG_REF[i // 2]) for i in (0, 2, 4))
    fr, fg, fb = f.split()
    s = re.sub(r'<defs><filter id="fmtint".*?</defs>', '', s, flags=re.S).replace(' filter="url(#fmtint)"', '')
    defs = ('<defs><filter id="fmtint" color-interpolation-filters="sRGB"><feColorMatrix type="matrix" values="%s 0 0 0 0  0 %s 0 0 0  0 0 %s 0 0  0 0 0 1 0"/></filter></defs>' % (fr, fg, fb))
    s = re.sub(r'(<svg[^>]*>)', lambda m: m.group(1) + defs, s, count=1)
    return s.replace('<image ', '<image filter="url(#fmtint)" ', 1)

def folder_icons(color):
    back, paper = shift(color, (-24,) * 3), shift(color, (27,) * 3)
    out = []
    for p in folder_icon_files():
        s = open(p).read()
        if '<image' in s and 'base64,' in s:
            out.append((p, tint_png_folder(s, color))); continue
        if len(FOLDER_FILL.findall(s)) != 3:
            print('fm-tweaks: %s does not look like the round-folder-icons design (skipped)' % p, file=sys.stderr); continue
        cols = iter((back, paper, color))
        out.append((p, FOLDER_FILL.sub(lambda m: 'style="fill:#%s"' % next(cols), s)))
    return out

def outputs(e):
    v = read_conf()
    t = tokens(e)
    sm = sm_view(e, v); tsm = tokens(sm)
    shared = render('shared.qss.in', t)
    shared_sm = render('shared.qss.in', tsm)
    out = [
        (os.path.join(THUNAR_OUT, 'gtk-3.0/gtk.css'), render('thunar.css.in', t)),
        (os.path.join(THUNAR_OUT, 'user.css'), render('thunar-user.css.in', t)),
        (os.path.join(THUNAR_OUT, 'gtk4.css'), render('thunar-gtk4.css.in', t)),
        (QT_QSS, shared),
        (QT_THEME, qt_theme_conf(e, t, QT_FONT)),
        (QT_THEME_SM, qt_theme_conf(sm, tsm)),
    ] + folder_icons(e['foldercolor']) + [(os.path.join(os.path.dirname(SMPLAYER_QSS), n), svg) for n, svg in qt_svgs(sm).items()] + [
        (SMPLAYER_QSS, shared_sm.rstrip('\n') + '\n\n' + render('smplayer.qss.in', tsm)),
    ]
    return out

def link_smplayer_icons(dry):
    dst = os.path.join(os.path.dirname(SMPLAYER_QSS), os.path.basename(SMPLAYER_RCC_SRC))
    if dry or not os.path.exists(SMPLAYER_RCC_SRC) or os.path.lexists(dst): return
    os.makedirs(os.path.dirname(dst), exist_ok=True); os.symlink(SMPLAYER_RCC_SRC, dst); print('linked', dst)

def cmd_apply(dry=False, quiet=False):
    n = 0
    link_smplayer_icons(dry)
    for path, new in outputs(effective(read_conf())):
        old = open(path).read() if os.path.exists(path) else None
        if new != old:
            n += 1
            if not dry:
                atomic_write(path, new)
            if not quiet:
                print('%s %s' % ('would update' if dry else 'updated', path))
    if not quiet:
        print(('%d file(s) %s; restart Thunar to see changes.' % (n, 'differ' if dry else 'changed')) if n else 'already in sync, nothing to do.')
    return n

def cmd_status():
    bad = 0
    for path, new in outputs(effective(read_conf())):
        old = open(path).read() if os.path.exists(path) else None
        if old == new:
            print('ok    ' + path)
            continue
        bad += 1
        print('DRIFT ' + path + ('  (missing)' if old is None else ''))
        if old is not None:
            for i, (x, y) in enumerate(zip(old.split('\n'), new.split('\n'))):
                if x != y:
                    print('   line %d: %s  ->  %s' % (i + 1, x.strip(), y.strip()))
                    break
    return 1 if bad else 0

def cmd_list():
    v, e = read_conf(), effective(read_conf())
    for s, k, d, kind, doc in KEYS:
        cur = e[k] if kind == 'color?' else v[k]
        print('%-12s %-8s (default %-7s) %s' % (k, cur, d or 'follow', doc))

def main(argv):
    if not argv or argv[0] in ('-h', '--help'):
        print(__doc__); return 0
    c = argv[0]
    if c == 'apply':
        cmd_apply('--dry-run' in argv, '--quiet' in argv); return 0
    if c == 'status':
        return cmd_status()
    if c == 'list':
        cmd_list(); return 0
    if c == 'init':
        if os.path.exists(CONF):
            sys.exit('fm-tweaks: %s already exists' % CONF)
        atomic_write(CONF, conf_text()); print('wrote ' + CONF); return 0
    if c == 'get' and len(argv) == 2 or c == 'color' and len(argv) == 3 and argv[2] == '--get':
        k = argv[1]
        if k not in BYKEY:
            sys.exit('unknown key %s (see: fm-tweaks list)' % k)
        print(effective(read_conf())[k]); return 0
    if c in ('set', 'color') and len(argv) == 3:
        key, val = argv[1], argv[2].strip()
        if key not in BYKEY:
            sys.exit('unknown key %s (see: fm-tweaks list)' % key)
        kind = BYKEY[key][3]
        if not val and kind != 'color?':
            sys.exit('%s cannot be cleared' % key)
        parsed = parse_value(key, val) if val else ''
        changes = {key: parsed}
        if c == 'color' and key == 'view':
            changes.update({'statusbar': ''})
        write_conf_keys(changes)
        cmd_apply(); return 0
    sys.exit(__doc__)

if __name__ == '__main__':
    sys.exit(main(sys.argv[1:]))
