#!/usr/bin/env python3
"""
fm-tweaks - one config, one generator for the personal file-manager / Qt look: Thunar, SMPlayer, Konsole/Ark/kcolorchooser.

  conf      ~/.config/fm-tweaks/fm-tweaks.conf   (the ONLY file you edit; `init` writes it from the defaults below)
  templates <repo>/templates/*.in                           ({{token}} placeholders; human-readable, hand-edited)
  outputs   (GENERATED, never hand-edited; changed files only are rewritten): the Thunar css (~/.themes/fm-sample), the general Qt look for the wrapped
            apps (~/.themes/qt-fm/{qt-general,kcolorchooser}.qss, ~/.config/fm-tweaks/qt-theme.conf, bluegrey.colors + the [Colors:*] blocks of kdeglobals)
            and SMPlayer's own palette (qt-theme-smplayer.conf + style.qss from the sm* keys). See README.md.

Commands:
  apply [--dry-run] [--quiet]   write the outputs from the conf (idempotent)
  status                        show drift between conf and outputs (exit 1 if any)
  list                          every key: current value, default, meaning
  get <key>                     effective value (override keys fall back to what they follow)
  set <key> <value>             change a key in the conf, then apply   (`set <override> ""` clears an override)
  color <key> <hex|--get>       same as get/set for color keys; setting `view` also clears the statusbar override (Knomadic rows use this)
  init                          write the conf from the defaults (refuses to overwrite)
Restart Thunar / the Qt app to see changes.
"""
import os, re, sys

HOME = os.path.expanduser('~')
HERE = os.path.dirname(os.path.realpath(__file__))
ROOT = os.path.dirname(HERE)
TEMPLATES = os.path.join(ROOT, 'templates')
CONF = os.environ.get('FM_TWEAKS_CONF') or os.path.join(HOME, '.config/fm-tweaks/fm-tweaks.conf')
QT_QSS = os.environ.get('FM_TWEAKS_QT_QSS') or os.path.join(HOME, '.themes/qt-fm/qt-general.qss')   # rounded menus/tooltips for every wrapped Qt app (~/.local/bin/konsole, ark: -stylesheet)
KCOLOR_QSS = os.environ.get('FM_TWEAKS_KCOLOR_QSS') or os.path.join(HOME, '.themes/qt-fm/kcolorchooser.qss')   # qt-general.qss + frameless colour swatches; Knomadic passes it to kcolorchooser
KDE_SCHEME = os.environ.get('FM_TWEAKS_KDE_SCHEME') or os.path.join(HOME, '.local/share/color-schemes/bluegrey.colors')   # KColorScheme Konsole reads (toolbar, menu text)
KDEGLOBALS = os.environ.get('FM_TWEAKS_KDEGLOBALS') or os.path.join(HOME, '.config/kdeglobals')   # only its [Colors:*] blocks are rewritten
SMPLAYER_QSS = os.environ.get('FM_TWEAKS_SMPLAYER_QSS') or os.path.join(HOME, '.config/smplayer/themes/PapirusDark/style.qss')   # SMPlayer loads ITS app stylesheet from here (not from -stylesheet); shared menu/tooltip rules only
SMPLAYER_RCC_SRC = next((p for p in (os.path.join(HOME, '.local/opt/smplayer-qt6/share/smplayer/themes/PapirusDark/PapirusDark.rcc'), '/usr/share/smplayer/themes/PapirusDark/PapirusDark.rcc') if os.path.exists(p)), '')   # icon bundle (Asahi private prefix, else the Debian package dir)
QT_THEME = os.environ.get('FM_TWEAKS_QT_THEME') or os.path.join(HOME, '.config/fm-tweaks/qt-theme.conf')   # read by the qt-fm shim (replaces qt6ct) for every wrapped Qt app: palette + font + icon theme
QT_THEME_SM = os.environ.get('FM_TWEAKS_QT_THEME_SM') or os.path.join(HOME, '.config/fm-tweaks/qt-theme-smplayer.conf')   # SMPlayer's own (darker) palette; its wrapper sets FM_QT_THEME to this
QT_FONT, QT_ICON_THEME = 'SF Pro Regular,14', 'MacTahoe-nord-dark'  # 14 = what qt6ct used for the wrapped Qt apps
SMPLAYER_MENU_RADIUS = (16, 8)   # menu, highlighted item (px): SMPlayer runs scaled 0.8 (hdpi.ini), so a bit bigger than the shared 10/5
THUNAR_OUT = os.environ.get('FM_TWEAKS_THUNAR_OUT') or os.path.join(HOME, '.themes/fm-sample')   # the Thunar/GTK3 trial theme (thunar-fm)

# ---------------------------------------------------------------- the key table: the single place that knows every setting
# (section, key, default, kind, meaning). kind: color | color? (optional override, empty = follow) | float
KEYS = [
    ('colors', 'sidebar',     '383840', 'color',  'Places panel background'),
    ('colors', 'view',        '1c1c20', 'color',  'main file view background; also toolbar/location bar, status bar, column-header row'),
    ('colors', 'accent',      '5a3e8b', 'color',  'selection fill, hover tint, focus ring, context-menu highlight'),
    ('colors', 'window',      '2c2c31', 'color',  'menus (Thunar), Qt window background'),
    ('colors', 'tooltip',     '383840', 'color',  'tooltips, context menus, Open With dialog (shared.qss)'),
    ('overrides', 'statusbar', '',      'color?', 'status bar background (empty = follow view)'),
    ('overrides', 'button',   '',       'color?', 'column-header (Name/Size) bar, push buttons + the Qt button swatch (empty = view shifted by D_BUTTON); the Thunar titlebar has its own key `titlebar`'),
    ('overrides', 'titlebar', '',      'color?', 'Thunar titlebar (empty = follow button)'),
    ('overrides', 'sidebarhl', '',      'color?', 'selected row in the Places sidebar - Thunar only (empty = follow accent)'),
    ('text', 'text',          'deddda', 'color',  'general text: file names + details, Qt app text'),
    ('text', 'sidebartext',   'dcdcdc', 'color',  'Places panel text'),
    ('text', 'buttontext',    'dcdcdc', 'color',  'column-header row + menu item text'),
    ('text', 'statustext',    'dcdcdc', 'color',  'status bar labels (message, item count, zoom, progress)'),
    ('text', 'hltext',        'ffffff', 'color',  'text on highlighted (selected / hovered menu) rows - Thunar only'),
    ('smplayer', 'menubar_hidden', 'true', 'bool', 'SMPlayer: hide the menu bar until the toggle key is pressed'),
    ('smplayer', 'menubar_key', 'Ctrl+M', 'text', 'SMPlayer: key that shows/hides the menu bar (free it in SMPlayer first; empty = none)'),
    ('smplayer', 'hide_dock_titles', 'true', 'bool', 'SMPlayer: hide the "Untitled playlist" title strip above the playlist'),
    ('smplayer', 'hide_logo', 'true', 'bool', 'SMPlayer: no logo in the empty video window'),
    ('smplayer', 'hide_playlist_toolbar', 'true', 'bool', 'SMPlayer: hide the playlist button row (load/save/add/remove/play/shuffle/search)'),
    ('smplayer', 'playlist_number_col_width', '25', 'text', 'SMPlayer: playlist number column width in px at launch (default was ~100; 0 = leave alone; still draggable)'),
    ('smplayer', 'smmenu',    '', 'color?', 'SMPlayer menu bar, menus, combo popups, tooltips (empty = follow tooltip)'),
    ('smplayer', 'smpanel',   '', 'color?', 'SMPlayer dialogs, toolbar + control row, dock, tab pages (empty = follow window)'),
    ('smplayer', 'smcontent', '', 'color?', 'SMPlayer playlist body, Preferences page list, log and text areas (empty = follow view)'),
    ('smplayer', 'smfield',   '', 'color?', 'SMPlayer text fields, buttons, table headers, scrollbar + slider grooves (empty = follow button)'),
    ('smplayer', 'smaccent',  '', 'color?', 'SMPlayer selection, slider fill, default button, checked tool buttons (empty = follow accent)'),
    ('smplayer', 'smstatus',  '', 'color?', 'SMPlayer status bar background (empty = follow statusbar)'),
    ('smplayer', 'smtext',    '', 'color?', 'SMPlayer text, incl. buttons and menu items (empty = follow text)'),
    ('smplayer', 'smstatustext', '', 'color?', 'SMPlayer status bar text (empty = follow statustext)'),
    ('smplayer', 'smhltext',  '', 'color?', 'SMPlayer text on highlighted rows (empty = follow hltext)'),
    ('thunar', 'inactivetext', '0.53',  'float',  'Thunar: opacity of the inactive split pane (lower = dimmer)'),
]
BYKEY = {k[1]: k for k in KEYS}
HEX = re.compile(r'^#?([0-9a-fA-F]{6})$')

# Fixed look relationships (one set for every machine; per-machine differences come from the base colors in the conf)
D_BUTTON = (-6, -6, -8)     # column-header row = view + this
D_TIPBORDER = (18, 18, 18)  # tooltip border = tooltip + this
D_DIVIDER = (7, 7, 8)       # Thunar pane dividers = view + this
D_ACCENT_HOVER = (18, 8, 21)  # Thunar default-dialog-button hover = accent + this

def shift(h, d):
    return ''.join('%02x' % max(0, min(255, int(h[i:i + 2], 16) + d[i // 2])) for i in (0, 2, 4))

def dec(h):
    return '%d,%d,%d' % (int(h[0:2], 16), int(h[2:4], 16), int(h[4:6], 16))

# ---------------------------------------------------------------- conf
def parse_value(key, raw):
    kind = BYKEY[key][3]
    raw = raw.strip()
    if kind in ('bool', 'text'):
        raw = re.split(r'\s+#', raw, maxsplit=1)[0].strip()
        if kind == 'bool' and raw.lower() not in ('true', 'false'):
            sys.exit('fm-tweaks: %s must be true or false, got %r' % (key, raw))
        return raw.lower() if kind == 'bool' else raw
    if kind == 'float':
        m = re.match(r'^[0-9]*\.?[0-9]+', raw)
        if not m:
            sys.exit('fm-tweaks: %s must be a number, got %r' % (key, raw))
        return m.group(0)
    m = re.match(r'^#?([0-9a-fA-F]{6})(?:\s|$)', raw)
    if m:
        return m.group(1).lower()
    if kind == 'color?' and re.match(r'^(#(\s|$)|$)', raw):   # empty: a following `# comment` is not a value
        return ''
    sys.exit('fm-tweaks: bad value for %s: %r' % (key, raw))

def read_conf():
    vals = {k[1]: k[2] for k in KEYS}                # defaults fill whatever the conf doesn't say
    if os.path.exists(CONF):
        for ln in open(CONF).read().split('\n'):
            m = re.match(r'^\s*([a-z]+)\s*=\s*(.*)$', ln)
            if m and not ln.lstrip().startswith('#') and m.group(1) in BYKEY:
                vals[m.group(1)] = parse_value(m.group(1), m.group(2)) if m.group(2).strip() else (vals[m.group(1)] if BYKEY[m.group(1)][3] != 'color?' else '')
    return vals

SM_FOLLOW = {'smmenu': 'tooltip', 'smpanel': 'window', 'smcontent': 'view', 'smfield': 'button', 'smaccent': 'accent', 'smstatus': 'statusbar', 'smtext': 'text', 'smstatustext': 'statustext', 'smhltext': 'hltext'}

def effective(v):
    e = dict(v)
    e['statusbar'] = v['statusbar'] or v['view']
    e['button'] = v['button'] or shift(v['view'], D_BUTTON)
    e['sidebarhl'] = v['sidebarhl'] or v['accent']
    e['titlebar'] = v['titlebar'] or e['button']
    for k, follow in SM_FOLLOW.items():
        e[k] = v[k] or e[follow]
    return e

def write_conf_keys(changes):
    """apply {key: value} to the conf text in memory, then write ONCE (all-or-nothing); creates the conf from the defaults when missing"""
    text = open(CONF).read() if os.path.exists(CONF) else conf_text()
    for key, val in changes.items():
        shown = ('#' + val) if BYKEY[key][3] in ('color', 'color?') and val else val
        # exactly one space on each side of the value so it can never fuse with the trailing `# comment`
        text, n = re.subn(r'(?m)^([ \t]*%s[ \t]*=)[ \t]*(?:#?[0-9a-fA-F]{6}\b|[0-9]*\.?[0-9]+\b|true\b|false\b|[A-Za-z+]+(?=[ \t]|$))?[ \t]*' % re.escape(key),
                          lambda m: m.group(1) + ' ' + shown + ' ', text, count=1)
        if n == 0:   # a key added in a newer version: append it to its section (or create the section)
            sec, _, _, kind, doc = BYKEY[key][0], 0, 0, BYKEY[key][3], BYKEY[key][4]
            line = '%-12s = %s  # %s' % (key, shown, doc)
            m = re.search(r'(?ms)^\[%s\][ \t]*\n(.*?)(?=^\[|\Z)' % re.escape(sec), text)
            if m:
                body = m.group(1).rstrip('\n')
                text = text[:m.start(1)] + body + ('\n' if body else '') + line + '\n\n' + text[m.end(1):].lstrip('\n')
            else:
                text = text.rstrip('\n') + '\n\n[%s]\n%s\n' % (sec, line)
    atomic_write(CONF, text)

def conf_text():
    out = ['# fm-tweaks.conf - the single source of truth for the Thunar / SMPlayer / Qt app look. Edit here, or: fm-tweaks set <key> <value>.',
           '# `fm-tweaks apply` regenerates every output (Knomadic rows do it via fm-color.sh). Restart Thunar / the app to see changes.', '']
    sec = None
    for s, k, d, kind, doc in KEYS:
        if s != sec:
            out += ['[%s]' % s]
            sec = s
        val = ('#' + d if d and kind in ('color', 'color?') else d)
        out.append('%-12s = %-8s  # %s' % (k, val, doc))
        if k in ('statustext', 'statusbar', 'tooltip'):
            out.append('')
    return '\n'.join(out) + '\n'

# ---------------------------------------------------------------- templates -> outputs
def atomic_write(path, text):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    tmp = path + '.tmp-fm-tweaks'
    with open(tmp, 'w') as f:
        f.write(text)
    if os.path.exists(path):
        os.chmod(tmp, os.stat(path).st_mode & 0o777)
    os.replace(tmp, path)

def tokens(e):
    v = e['view']
    t = {k: '#' + e[k] for k in ('sidebar', 'view', 'accent', 'window', 'tooltip', 'statusbar',
                                 'text', 'sidebartext', 'buttontext', 'statustext', 'button', 'sidebarhl', 'hltext', 'titlebar')}
    t['inactivetext'] = e['inactivetext']
    # Thunar paints the file-view selection as accent_bg_color at 50% alpha over the view colour: accent_paint = 2*accent - view (clamped), so it lands on the swatch
    t['accent_paint'] = '#' + ''.join('%02x' % max(0, min(255, 2 * int(e['accent'][i:i + 2], 16) - int(e['view'][i:i + 2], 16))) for i in (0, 2, 4))
    t['divider'] = '#' + shift(v, D_DIVIDER)
    t['accent_hover'] = '#' + shift(e['accent'], D_ACCENT_HOVER)
    t['tipborder'] = '#' + shift(e['tooltip'], D_TIPBORDER)
    for k in ('view', 'window', 'accent', 'text', 'buttontext'):
        t[k + '_dec'] = dec(e[k])
    t['button_dec'] = dec(e['button'])
    t['asset_dir'] = os.path.dirname(SMPLAYER_QSS)
    t['text_dim'] = '#' + shift(e['text'], (-70, -70, -70))
    return t

def sm_view(e, v):
    """the colour set SMPlayer is rendered from: every swatch the shared SMPlayer templates use is replaced by its own sm* key (which follows the main one until set)"""
    s = dict(e)
    s.update(tooltip=e['smmenu'], window=e['smpanel'], view=e['smcontent'], button=e['smfield'], accent=e['smaccent'], statusbar=e['smstatus'],
             text=e['smtext'], buttontext=v['smtext'] or e['buttontext'], statustext=e['smstatustext'], hltext=e['smhltext'])
    return s

KDE_SETS = (('Window', 'window', 'text'), ('View', 'view', 'text'), ('Selection', 'accent', 'hltext'), ('Button', 'button', 'buttontext'), ('Tooltip', 'tooltip', 'text'))

def kde_block(name, bg, fg, accent):
    rgb = lambda h: dec(h)
    rows = [('BackgroundAlternate', rgb(bg)), ('BackgroundNormal', rgb(bg)), ('DecorationFocus', rgb(accent)), ('DecorationHover', rgb(shift(bg, (10, 10, 12)))),
            ('ForegroundActive', rgb(fg)), ('ForegroundInactive', rgb(fg)), ('ForegroundLink', rgb(fg)), ('ForegroundNegative', '130,12,16'), ('ForegroundNeutral', rgb(fg)),
            ('ForegroundNormal', rgb(fg)), ('ForegroundPositive', rgb(fg)), ('ForegroundVisited', rgb(fg))]
    return '[Colors:%s]\n' % name + ''.join('%s=%s\n' % kv for kv in rows) + '\n'

def kde_colors(e):
    return ''.join(kde_block(n, e[bg], e[fg], e['accent']) for n, bg, fg in KDE_SETS)

def kde_scheme(e):
    """bluegrey.colors: a complete KColorScheme file (Konsole's toolbar + menu text read it)"""
    return kde_colors(e) + '[ColorEffects:Inactive]\nChangeSelectionColor=false\nColor=%s\nColorAmount=0\nColorEffect=0\nContrastAmount=0\nContrastEffect=0\nIntensityAmount=0\nIntensityEffect=0\n\n[Icons]\nTheme=%s\n\n[General]\nColorScheme=bluegrey\nName=bluegrey\nshadeSortColumn=false\n' % (dec(e['window']), QT_ICON_THEME)

def kdeglobals_text(e, old):
    """kdeglobals: only the [Colors:<set>] blocks of the five sets are replaced (anchored); every other key stays as it is"""
    out = old
    for n, bg, fg in KDE_SETS:
        blk = kde_block(n, e[bg], e[fg], e['accent'])
        pat = r'(?ms)^\[Colors:%s\][ \t]*\n.*?(?=^\[|\Z)' % n
        out = re.sub(pat, lambda m: blk, out, count=1) if re.search(pat, out) else out.rstrip('\n') + '\n\n' + blk
    return out

KCOLOR_EXTRA = """
/* kcolorchooser: no 1px frames around the preview swatch and the colour pickers, so colours can be compared */
QColorDialog QFrame, QColorShowLabel, QColorPicker, QColorLuminancePicker { border: none; border-width: 0px; }
"""

def qt_svgs(e):
    """tiny glyphs the SMPlayer stylesheet needs (QSS can't draw arrows / check marks): coloured from the swatches"""
    x = '#' + e['buttontext']; hl = '#' + e['hltext']
    head = '<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 16 16">'
    return {'arrow-down.svg': head + '<path d="M4 6l4 4 4-4" fill="none" stroke="%s" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>' % x,
            'arrow-up.svg': head + '<path d="M4 10l4-4 4 4" fill="none" stroke="%s" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>' % x,
            'check.svg': head + '<path d="M3.5 8.5l3 3 6-6.5" fill="none" stroke="%s" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>' % hl,
            'radio.svg': head + '<circle cx="8" cy="8" r="3" fill="%s"/></svg>' % hl}

def qt_theme_conf(e, t, font=None):
    """palette for the qt-fm shim, role order = QPalette::ColorRole 0..21 (same order qt6ct used)"""
    a = lambda h, al='ff': '#' + al + h.lstrip('#')
    w, text = e['window'], e['text']
    def roles(dis):
        tx = (lambda h: a(h, '80')) if dis else (lambda h: a(h))
        return [tx(text), a(e['button']), a(shift(w, (40, 40, 44))), a(shift(w, (20, 20, 22))), a(shift(w, (-22, -22, -24))), a(shift(w, (-12, -12, -13))), tx(text), a('ffffff'), tx(e['buttontext']),
                a(e['view']), a(w), a('000000'), a(e['accent']), a(e['hltext']), a(shift(e['accent'], (60, 60, 70))), a(shift(e['accent'], (30, 20, 50))), a(shift(e['view'], (6, 6, 8))),
                a(w), a(e['tooltip']), a(text), a(text, '70'), a(e['accent'])]
    return '# GENERATED by fm-tweaks (qt_theme_conf) - read by ~/.themes/qt-fm/libqt-fm.so\n[colors]\nactive=%s\ninactive=%s\ndisabled=%s\n\n%s[icons]\ntheme=%s\n\n[ui.smplayer]\nmenubar_hidden=%s\nmenubar_key=%s\nhide_dock_titles=%s\nhide_logo=%s\nhide_playlist_toolbar=%s\nplaylist_number_col_width=%s\n' % (', '.join(roles(False)), ', '.join(roles(False)), ', '.join(roles(True)), ('[fonts]\ngeneral=%s\n\n' % font if font else ''), QT_ICON_THEME, e['menubar_hidden'], e['menubar_key'], e['hide_dock_titles'], e['hide_logo'], e['hide_playlist_toolbar'], e['playlist_number_col_width'])

def render(name, t):
    text = open(os.path.join(TEMPLATES, name)).read()
    missing = set(re.findall(r'\{\{(\w+)\}\}', text)) - set(t)
    if missing:
        sys.exit('fm-tweaks: template %s uses unknown token(s): %s' % (name, ', '.join(sorted(missing))))
    return re.sub(r'\{\{(\w+)\}\}', lambda m: t[m.group(1)], text)

def outputs(e):
    v = read_conf()
    t = tokens(e)
    sm = sm_view(e, v); tsm = tokens(sm)
    shared = render('shared.qss.in', t)
    shared_sm = render('shared.qss.in', tsm)
    out = [
        (os.path.join(THUNAR_OUT, 'gtk-3.0/gtk.css'), render('thunar.css.in', t)),
        (os.path.join(THUNAR_OUT, 'user.css'), render('thunar-user.css.in', t)),
        (os.path.join(THUNAR_OUT, 'gtk4.css'), render('thunar-gtk4.css.in', t)),
        (QT_QSS, shared),
        (KCOLOR_QSS, shared.rstrip('\n') + '\n' + KCOLOR_EXTRA),
        (QT_THEME, qt_theme_conf(e, t, QT_FONT)),
        (QT_THEME_SM, qt_theme_conf(sm, tsm)),
        (KDE_SCHEME, kde_scheme(e)),
    ] + [(os.path.join(os.path.dirname(SMPLAYER_QSS), n), svg) for n, svg in qt_svgs(sm).items()] + [
        (SMPLAYER_QSS, shared_sm.replace('border-radius: 10px', 'border-radius: %dpx' % SMPLAYER_MENU_RADIUS[0]).replace('border-radius: 5px', 'border-radius: %dpx' % SMPLAYER_MENU_RADIUS[1]).rstrip('\n') + '\n\n' + render('smplayer.qss.in', tsm)),
    ]
    kg = os.path.realpath(KDEGLOBALS)   # ~/.config/kdeglobals is a symlink into ~/.themes: write the target, never replace the link
    if os.path.exists(kg):
        out.append((kg, kdeglobals_text(e, open(kg).read())))
    return out

def link_smplayer_icons(dry):
    dst = os.path.join(os.path.dirname(SMPLAYER_QSS), os.path.basename(SMPLAYER_RCC_SRC))
    if dry or not os.path.exists(SMPLAYER_RCC_SRC) or os.path.lexists(dst): return
    os.makedirs(os.path.dirname(dst), exist_ok=True); os.symlink(SMPLAYER_RCC_SRC, dst); print('linked', dst)

def cmd_apply(dry=False, quiet=False):
    n = 0
    link_smplayer_icons(dry)
    for path, new in outputs(effective(read_conf())):
        old = open(path).read() if os.path.exists(path) else None
        if new != old:
            n += 1
            if not dry:
                atomic_write(path, new)
            if not quiet:
                print('%s %s' % ('would update' if dry else 'updated', path))
    if not quiet:
        print(('%d file(s) %s; restart Thunar to see changes.' % (n, 'differ' if dry else 'changed')) if n else 'already in sync, nothing to do.')
    return n

def cmd_status():
    bad = 0
    for path, new in outputs(effective(read_conf())):
        old = open(path).read() if os.path.exists(path) else None
        if old == new:
            print('ok    ' + path)
            continue
        bad += 1
        print('DRIFT ' + path + ('  (missing)' if old is None else ''))
        if old is not None:
            for i, (x, y) in enumerate(zip(old.split('\n'), new.split('\n'))):
                if x != y:
                    print('   line %d: %s  ->  %s' % (i + 1, x.strip(), y.strip()))
                    break
    return 1 if bad else 0

def cmd_list():
    v, e = read_conf(), effective(read_conf())
    for s, k, d, kind, doc in KEYS:
        cur = e[k] if kind == 'color?' else v[k]
        print('%-12s %-8s (default %-7s) %s' % (k, cur, d or 'follow', doc))

def main(argv):
    if not argv or argv[0] in ('-h', '--help'):
        print(__doc__); return 0
    c = argv[0]
    if c == 'apply':
        cmd_apply('--dry-run' in argv, '--quiet' in argv); return 0
    if c == 'status':
        return cmd_status()
    if c == 'list':
        cmd_list(); return 0
    if c == 'init':
        if os.path.exists(CONF):
            sys.exit('fm-tweaks: %s already exists' % CONF)
        atomic_write(CONF, conf_text()); print('wrote ' + CONF); return 0
    if c == 'get' and len(argv) == 2 or c == 'color' and len(argv) == 3 and argv[2] == '--get':
        k = argv[1]
        if k not in BYKEY:
            sys.exit('unknown key %s (see: fm-tweaks list)' % k)
        print(effective(read_conf())[k]); return 0
    if c in ('set', 'color') and len(argv) == 3:
        key, val = argv[1], argv[2].strip()
        if key not in BYKEY:
            sys.exit('unknown key %s (see: fm-tweaks list)' % key)
        kind = BYKEY[key][3]
        if not val and kind != 'color?':
            sys.exit('%s cannot be cleared' % key)
        parsed = parse_value(key, val) if val else ''
        changes = {key: parsed}
        if c == 'color' and key == 'view':
            changes.update({'statusbar': ''})
        write_conf_keys(changes)
        cmd_apply(); return 0
    sys.exit(__doc__)

if __name__ == '__main__':
    sys.exit(main(sys.argv[1:]))
