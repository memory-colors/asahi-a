#!/usr/bin/env python3
"""flat-mime-icons - make every size of MacTahoe-nord-dark's file-type icons use the FLAT 22px set (the list-size look), never the
folded-corner page / QuickTime-tile "scalable" set. Writes a user-owned overlay ~/.local/share/icons/MacTahoe-nord-dark/mimes/scalable (and mimes@2x/scalable)
of symlinks; GTK and Qt search ~/.local/share/icons BEFORE /usr/share/icons, so no root and the system theme is untouched. Re-run after an icon-theme update.
Per name: the flat 22px icon of the same name; else of any name along the theme's own symlink chain; else a generic by prefix. Remove: rm -r the overlay mimes dirs.
usage: flat-mime-icons [--dry-run]
"""
import os, sys
SYS = '/usr/share/icons/MacTahoe-nord-dark'
FLAT = '/usr/share/icons/MacTahoe-nord/mimes/22'
DST = os.path.expanduser('~/.local/share/icons/MacTahoe-nord-dark')
dry = '--dry-run' in sys.argv
GENERIC = [('video', 'video-x-generic'), ('audio', 'audio-x-generic'), ('image', 'image-x-generic'), ('text', 'text-x-generic'),
           ('font', 'font-x-generic'), ('application', 'text-x-generic')]   # the flat 'unknown'/'application-x-generic' is a plain grey page with a folded corner: not used
NOPAGE = {'unknown', 'application-octet-stream', 'application-x-generic', 'application-blank', 'application-x-zerosize', 'text-x-preview'}   # catch-alls -> the 'lines' icon
def flat_for(name, path):
    if name in NOPAGE: return os.path.realpath(os.path.join(FLAT, 'text-x-generic.svg')), 'generic'
    chain, p, seen = [name], path, 0
    while os.path.islink(p) and seen < 10:
        t = os.readlink(p); p = os.path.join(os.path.dirname(p), t); chain.append(os.path.splitext(os.path.basename(t))[0]); seen += 1
    for c in chain:
        f = os.path.join(FLAT, c + '.svg')
        if os.path.exists(f): return os.path.realpath(f), 'exact'
    for pre, g in GENERIC:
        if name.startswith(pre):
            f = os.path.join(FLAT, g + '.svg')
            if os.path.exists(f): return os.path.realpath(f), 'generic'
    return os.path.realpath(os.path.join(FLAT, 'text-x-generic.svg')), 'generic'
tot = {'exact': 0, 'generic': 0, 'skipped': 0}
for sub in ('mimes/scalable', 'mimes@2x/scalable'):
    src = os.path.join(SYS, sub)
    if not os.path.isdir(src): continue
    out = os.path.join(DST, sub)
    if not dry: os.makedirs(out, exist_ok=True)
    for f in sorted(os.listdir(src)):
        if not f.endswith('.svg'): continue
        tgt, how = flat_for(os.path.splitext(f)[0], os.path.join(src, f))
        if not tgt: tot['skipped'] += 1; continue
        tot[how] += 1
        if dry: continue
        link = os.path.join(out, f)
        if os.path.islink(link) and os.readlink(link) == tgt: continue
        tmp = link + '.new'
        if os.path.lexists(tmp): os.remove(tmp)
        os.symlink(tgt, tmp); os.replace(tmp, link)
if not dry: os.system('gtk-update-icon-cache -f -t %s >/dev/null 2>&1' % DST) if os.path.exists(os.path.join(DST, 'index.theme')) else None
# every video type -> the mpv icon (read from mpv.desktop's Icon=), in all mime size dirs, so it holds at list size and at large sizes
VIDEO_APP = 'mpv.desktop'
def video_icon():
    try:
        import gi
        gi.require_version('Gtk', '3.0')
        from gi.repository import Gtk, Gio
        ic = Gio.DesktopAppInfo.new(VIDEO_APP).get_string('Icon')
        if os.path.isabs(ic): return ic
        th = Gtk.IconTheme.new(); th.set_custom_theme('MacTahoe-nord-dark'); i = th.lookup_icon(ic, 64, 0)
        return i.get_filename() if i else None
    except Exception: return None
vi = video_icon(); nvid = 0
if vi:
    for sub in ('mimes/16', 'mimes/22', 'mimes/scalable', 'mimes@2x/16', 'mimes@2x/22', 'mimes@2x/scalable'):
        names = set()
        for base in (os.path.join(SYS, sub), os.path.join(FLAT, '..', '..', 'mimes', sub.split('/')[1]) if sub == 'mimes/22' else None):
            if base and os.path.isdir(base): names |= {os.path.splitext(f)[0] for f in os.listdir(base) if f.startswith(('video-', 'video.', 'x-office-presentation-video')) and f.endswith('.svg')}
        names |= {'video-x-generic'}
        out = os.path.join(DST, sub)
        if dry: nvid += len(names); continue
        os.makedirs(out, exist_ok=True)
        for n in names:
            link = os.path.join(out, n + '.svg'); tmp = link + '.new'
            if os.path.lexists(tmp): os.remove(tmp)
            os.symlink(vi, tmp); os.replace(tmp, link); nvid += 1
tot['video->mpv'] = nvid
print('flat-mime-icons:', tot, '(dry run)' if dry else '-> ' + DST)
