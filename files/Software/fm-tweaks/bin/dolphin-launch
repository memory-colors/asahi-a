#!/bin/bash
# dolphin-launch - starts Dolphin with the personal tweaks.
#  1. `fm-tweaks apply` regenerates the QSS / color scheme / runtime conf from fm-tweaks.conf (a failure never blocks Dolphin)
#  2. preloads the shim (arrows, kinetic scroll, no stripes, pane dimming, ...) and the no-menu-icons shim; patched KF6 widgets lib; qt6ct platform theme
#  3. loads the generated QSS per app with -stylesheet (works where no global QSS replaces it)
# Env: DOLPHIN_LAUNCH_DRYRUN=1 prints instead of executing; FM_TWEAKS_LIBDIR (default ~/.themes/kf6-patched: shim + patched libs),
#      FM_TWEAKS_NOICONS (default ~/.themes/qt-noicons/libqt-noicons.so), FM_TWEAKS_OUT (generated files, default ~/.themes/dolphin-theme).
D="$(dirname "$(readlink -f "$0")")"
LIB="${FM_TWEAKS_LIBDIR:-$HOME/.themes/kf6-patched}"
NOICONS="${FM_TWEAKS_NOICONS:-$HOME/.themes/qt-noicons/libqt-noicons.so}"
OUT="${FM_TWEAKS_OUT:-$HOME/.themes/dolphin-theme}"
python3 "$D/fm-tweaks" apply --quiet >/dev/null 2>&1 || true
export QT_QPA_PLATFORMTHEME=qt6ct
export LD_LIBRARY_PATH="$LIB${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
export LD_PRELOAD="$LIB/libfm-tweaks.so:$NOICONS"
if [ -n "${DOLPHIN_LAUNCH_DRYRUN:-}" ]; then
    echo "LD_PRELOAD=$LD_PRELOAD"; echo "LD_LIBRARY_PATH=$LD_LIBRARY_PATH"; echo "QT_QPA_PLATFORMTHEME=$QT_QPA_PLATFORMTHEME"
    echo "exec dolphin -stylesheet $OUT/dolphin-theme.qss $*"; exit 0
fi
exec dolphin -stylesheet "$OUT/dolphin-theme.qss" "$@"
