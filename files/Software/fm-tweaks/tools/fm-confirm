#!/usr/bin/env python3
# fm-confirm TEXT [OK-LABEL] - small themed yes/no dialog for Thunar custom actions (zenity's question dialog can't show a title line and has no arrow-key focus).
# Exit 0 = confirmed, 1 = cancelled. OK has focus; Left/Right (and Tab) move between the buttons, Enter activates, Esc cancels. Themed by GTK_THEME=fm-sample (thunar.css.in "messagedialog" rules).
import sys, os, gi
from gi.repository import GLib as _GL
_GL.set_prgname('fm-confirm')                              # Wayland app id: the shell extension (popup/popupDismiss.js) closes this window on a click outside it
gi.require_version('Gtk', '3.0')
from gi.repository import Gtk, Gdk, GLib
text = sys.argv[1] if len(sys.argv) > 1 else 'Are you sure?'
ok = sys.argv[2] if len(sys.argv) > 2 else 'OK'
d = Gtk.MessageDialog(message_type=Gtk.MessageType.OTHER, buttons=Gtk.ButtonsType.NONE, text=text)
d.set_position(Gtk.WindowPosition.CENTER)
d.set_keep_above(True)
cancel = d.add_button('Cancel', Gtk.ResponseType.CANCEL)
yes = d.add_button(ok, Gtk.ResponseType.OK)
d.set_default_response(Gtk.ResponseType.OK)
yes.grab_focus()
def on_key(w, e):
    if e.keyval in (Gdk.KEY_Left, Gdk.KEY_Right):
        (cancel if w.get_focus() is yes else yes).grab_focus()
        return True
    return False
d.connect('key-press-event', on_key)
d.show_all()
shot = os.environ.get('FM_CONFIRM_SHOT')
if shot:
    def snap():
        import cairo
        a = d.get_allocation(); s = cairo.ImageSurface(cairo.FORMAT_ARGB32, a.width, a.height); d.draw(cairo.Context(s)); s.write_to_png(shot); d.response(Gtk.ResponseType.CANCEL); return False
    GLib.timeout_add(1200, snap)
sys.exit(0 if d.run() == Gtk.ResponseType.OK else 1)
