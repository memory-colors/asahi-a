#!/bin/bash
# fm-open-terminal PATH... - Thunar "Open in Terminal" (custom action, %F). New Ptyxis window per path (through the tile-right wrapper):
#   blank space / folder      -> terminal cd'd into it
#   executable script/binary  -> RUNS it in the file's folder; the window stays open afterwards ("[exit N] press Enter to close")
#   any other file            -> opens it in nano, in the file's folder
# "Executable" = the x bit AND a "#!" or ELF header (the trust-desktop-files script makes launchers executable; those are data, not programs).
# FM_TERMINAL overrides the terminal command (tests).
T=${FM_TERMINAL:-$HOME/.local/bin/ptyxis}
[ -x "$T" ] || T=ptyxis   # no tile-right wrapper on this machine (Debian): plain ptyxis from PATH
[ $# -gt 0 ] || set -- "$PWD"
for p; do
    if [ ! -e "$p" ]; then "$T" --new-window --working-directory "$PWD" & continue; fi
    if [ -d "$p" ]; then "$T" --new-window --working-directory "$p" & continue; fi
    d=$(dirname -- "$p")
    magic=$(head -c4 -- "$p" 2>/dev/null | LC_ALL=C tr -d '\0')
    if [ -x "$p" ] && { [ "${magic:0:2}" = '#!' ] || [ "$magic" = $'\x7fELF' ]; }; then
        "$T" --new-window --working-directory "$d" -- bash -c '"$1"; ec=$?; echo; printf "[exit %s] press Enter to close " "$ec"; read -r _' _ "$p" &
    else
        "$T" --new-window --working-directory "$d" -- nano -- "$p" &
    fi
done
wait
