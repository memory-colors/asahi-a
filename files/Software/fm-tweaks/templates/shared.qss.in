/* SHARED look (templates/shared.qss.in): rounded context menus + tooltips + the Open With dialog. Safe to load globally (e.g. qt6ct stylesheets=)
   or per app; the Dolphin-only rules live in dolphin.qss.in. GENERATED output - edit the template / dolphin-tweaks.conf, not this file. */
QMenu {
    background-color: {{tooltip}};
    border: 1px solid #45454d;
    border-radius: 10px;
    padding: 4px;
}
QMenu::item {
    padding: 4px 22px 4px 10px;
    margin-left: 0px;
    border-radius: 5px;
    font-size: 16px;
}
/* KNOMADIC: noicons-menu-padding - menus_have_icons=false / the noicons LD_PRELOAD shim stop Qt from drawing menu icons,
   but Qt still reserves the icon column's width via the QMenu::icon subcontrol; collapse it so the left padding above
   is the only indent. Ported from the Debian 2026-10-10 no-icons work (undocumented there; documented here instead). */
QMenu::icon {
    width: 0px;
    padding: 0px;
}
QMenu::item:selected {
    background-color: {{accent}};
    selection-background-color: {{accent}};
    border: none;
    color: white;
}
QMenu::separator {
    height: 1px;
    margin: 4px 8px;
}
QToolTip {
    background-color: {{tooltip}};
    border: 1px solid {{tipborder}};
    border-radius: 10px;
    padding: 4px 8px;
    font-size: 16px;
}
KOpenWithDialog {
    background-color: {{tooltip}};
}
KOpenWithDialog QTreeView {
    background-color: {{tooltip}};
}
