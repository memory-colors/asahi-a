/* GENERATED by fm-tweaks (templates/thunar-gtk4.css.in). GTK4/libadwaita dialogs that Thunar's custom actions open (zenity: New File, New Folder, Shred confirm) use the tooltip/menu colour. Loaded only via thunar-fm's private gtk-4.0/gtk.css. */
@define-color window_bg_color {{tooltip}};
@define-color window_fg_color {{text}};
@define-color dialog_bg_color {{tooltip}};
@define-color dialog_fg_color {{text}};
@define-color headerbar_bg_color {{tooltip}};
@define-color headerbar_fg_color {{text}};
@define-color headerbar_backdrop_color {{tooltip}};
@define-color popover_bg_color {{tooltip}};
@define-color popover_fg_color {{text}};
@define-color view_bg_color {{view}};
@define-color view_fg_color {{text}};
@define-color card_bg_color {{view}};
@define-color card_fg_color {{text}};
@define-color accent_bg_color {{accent}};
@define-color accent_color {{accent}};
@define-color accent_fg_color {{hltext}};
headerbar { box-shadow: none; border-bottom: none; }
/* Cancel / secondary buttons = the Thunar button colour; OK (default / suggested) = the main highlight */
button { background-image: none; background-color: {{button}}; color: {{buttontext}}; box-shadow: none; border: none; }
button:hover { background-color: shade({{button}}, 1.15); }
button.suggested-action, button.default, button.suggested-action:hover, button.default:hover { background-color: {{accent}}; color: {{hltext}}; }
button.suggested-action:hover, button.default:hover { background-color: shade({{accent}}, 1.12); }
/* libadwaita 1.6+ reads CSS variables for the accent (the system accent is blue); set them and the focus ring explicitly */
:root { --accent-bg-color: {{accent}}; --accent-color: {{accent}}; --accent-fg-color: {{hltext}}; --window-bg-color: {{tooltip}}; --dialog-bg-color: {{tooltip}}; --headerbar-bg-color: {{tooltip}}; --view-bg-color: {{view}}; }
entry:focus-within { outline-color: {{accent}}; }
entry { padding-left: 10px; padding-right: 10px; }
entry selection, text selection { background-color: {{accent}}; color: {{hltext}}; }
/* the global gtk-4.0 sheet wins the named-colour fight for the window grey, so set the surfaces directly (doubled class = higher specificity) */
window.background.background, window.dialog.background.background, window.background.csd.csd, window.messagedialog.background.background { background-color: {{tooltip}}; color: {{text}}; }
window.background.background headerbar, window.background.background headerbar.titlebar { background-color: {{tooltip}}; color: {{text}}; box-shadow: none; }
window.background.background entry { background-color: {{view}}; color: {{text}}; }
/* zenity dialogs are AdwMessageDialog: window.messagedialog > .message-area + .response-area > button.text-button (OK = .default) */
window.messagedialog .message-area { padding: 0; }
window.messagedialog .message-area > widget.child { margin: -12px -4px -4px -4px; }
window.messagedialog .response-area { padding: 4px 12px 12px 12px; }
window.background.messagedialog.csd .response-area button:not(.suggested-action):not(.destructive-action) { margin: 0 4px; padding: 4px 10px; min-height: 0; border-radius: 8px; background-image: none; background-color: {{button}}; color: {{buttontext}}; }
window.background.messagedialog.csd .response-area button:not(.suggested-action):not(.destructive-action):hover { background-color: shade({{button}}, 1.25); }
window.background.messagedialog.csd .response-area button.default:not(.suggested-action):not(.destructive-action) { background-color: {{accent}}; color: {{hltext}}; }
window.background.messagedialog.csd .response-area button.default:not(.suggested-action):not(.destructive-action):hover { background-color: shade({{accent}}, 1.15); }
/* one text size everywhere in these dialogs = the menu text size (12.5pt); roomier input, less padding */
window.messagedialog label, window.messagedialog .title-2, window.messagedialog .title-4, window.messagedialog entry, window.messagedialog entry text, window.messagedialog button, window.messagedialog button label { font-size: 12.5pt; }
window.messagedialog .title-2, window.messagedialog .title-4 { font-weight: 600; margin: 0 0 2px 0; padding: 0; }
window.messagedialog .heading-bin { margin: 0; padding: 0; }
window.messagedialog entry { min-height: 32px; padding-top: 4px; padding-bottom: 4px; }
window.messagedialog { min-width: 280px; }
window.messagedialog .response-area { padding: 0 6px 6px 6px; }
/* no heading text: the action is obvious (New File / New Folder) */
window.messagedialog .heading-bin, window.messagedialog .heading-bin label { font-size: 0; min-height: 0; margin: 0; padding: 0; opacity: 0; }
/* question-dialog text (zenity --question --text; the entry dialogs keep it empty and put "Name:" in the child widget below) */
window.messagedialog .body { font-size: 12.5pt; font-weight: 600; min-height: 0; margin: 0 0 4px 0; padding: 0; opacity: 1; }
/* no "Name:" label either, and no phantom titlebar strip */
window.messagedialog .message-area > widget.child label { font-size: 0; min-height: 0; margin: 0; padding: 0; opacity: 0; }
window.messagedialog > box.titlebar, window.messagedialog headerbar, window.messagedialog windowhandle { min-height: 0; margin: 0; padding: 0; }
window.messagedialog.csd > box.titlebar { min-height: 0; min-width: 0; padding: 0; margin: 0; border: none; }
/* zenity dialogs (New File / New Folder / Shred): no icon */
window.messagedialog image, window.messagedialog .message-area image { -gtk-icon-size: 0; min-width: 0; min-height: 0; margin: 0; padding: 0; opacity: 0; }
