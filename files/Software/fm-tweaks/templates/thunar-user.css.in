/* GENERATED by fm-tweaks (templates/thunar-user.css.in). Loaded by thunar-fm as Thunar's USER-level stylesheet (imported by its private gtk-3.0/gtk.css),
   because rules that fight Thunar's own CSS or the global user CSS only win at this priority. */
/* Thunar only: traffic lights moved right so the red button lines up with the l of "Places" (measured: 4px = original; 12px after the user asked for 2px back) */
headerbar button.titlebutton.close, headerbar button.titlebutton.minimize, headerbar button.titlebutton.maximize { min-width: 20px; min-height: 20px; background-size: 20px 20px; margin: 4px 0 0 0; }   /* same specificity as the global traffic-light rule (min 19px, margin 0 1px), which a plain .titlebutton selector loses to. Matched to Ptyxis' traffic lights by screenshot measurement: circle 17 css px, pitch 26 css px, 32 px in from the window's left edge, 19 px below its top (image px at scale 2); margin-top 4px = ~2 css px drop (buttons are centred) */
headerbar button.titlebutton.close { margin-left: 12px; }
/* split view: inactive pane keeps the same bg; the whole pane (icons + text) dims */
.split-view-inactive-pane .view, .split-view-inactive-pane treeview.view, .split-view-inactive-pane iconview { background-color: {{view}}; color: {{text}}; }
.split-view-inactive-pane { opacity: {{inactivetext}}; }

/* global ~/.config/gtk-3.0/gtk(-dark).css pin accent_bg_color at user priority and beat the theme, so redefine it here (this file is imported after it).
   accent_paint = the colour that, painted at 50% alpha over the view, lands on the highlight swatch. */
@define-color accent_bg_color {{accent_paint}};
@define-color accent_color {{accent}};
@define-color theme_selected_bg_color {{accent}};
@define-color selected_bg_color {{accent}};
/* selection is ALWAYS the swatch: focused, unfocused, window backdrop, hovered (adw-gtk3 turns backdrop selection pink otherwise) */
treeview.view:selected,
treeview.view:selected:focus,
treeview.view:selected:backdrop,
treeview.view:selected:backdrop:focus,
treeview.view:selected:hover,
treeview.view:selected:focus:hover,
treeview.view:selected:backdrop:hover,
iconview:selected,
iconview:selected:focus,
iconview:selected:backdrop,
iconview:selected:backdrop:focus,
iconview:selected:hover,
iconview:selected:focus:hover,
iconview:selected:backdrop:hover,
.view:selected,
.view:selected:focus,
.view:selected:backdrop,
.view:selected:backdrop:focus,
.view:selected:hover,
.view:selected:focus:hover,
.view:selected:backdrop:hover,
window .standard-view treeview.view:selected,
window .standard-view treeview.view:selected:focus,
window .standard-view treeview.view:selected:backdrop,
window .standard-view treeview.view:selected:backdrop:focus,
window .standard-view treeview.view:selected:hover,
window .standard-view treeview.view:selected:focus:hover,
window .standard-view treeview.view:selected:backdrop:hover,
window iconview:selected,
window iconview:selected:focus,
window iconview:selected:backdrop,
window iconview:selected:backdrop:focus,
window iconview:selected:hover,
window iconview:selected:focus:hover,
window iconview:selected:backdrop:hover {
  background-color: {{accent}}; background-image: none; color: {{hltext}}; opacity: 1; }
.sidebar treeview.view:selected,
.sidebar treeview.view:selected:focus,
.sidebar treeview.view:selected:backdrop,
.sidebar treeview.view:selected:backdrop:focus,
.sidebar treeview.view:selected:hover,
.sidebar treeview.view:selected:focus:hover,
.sidebar treeview.view:selected:backdrop:hover,
.sidebar row:selected,
.sidebar row:selected:focus,
.sidebar row:selected:backdrop,
.sidebar row:selected:backdrop:focus,
.sidebar row:selected:hover,
.sidebar row:selected:focus:hover,
.sidebar row:selected:backdrop:hover,
placessidebar row:selected,
placessidebar row:selected:focus,
placessidebar row:selected:backdrop,
placessidebar row:selected:backdrop:focus,
placessidebar row:selected:hover,
placessidebar row:selected:focus:hover,
placessidebar row:selected:backdrop:hover,
window .sidebar treeview.view:selected,
window .sidebar treeview.view:selected:focus,
window .sidebar treeview.view:selected:backdrop,
window .sidebar treeview.view:selected:backdrop:focus,
window .sidebar treeview.view:selected:hover,
window .sidebar treeview.view:selected:focus:hover,
window .sidebar treeview.view:selected:backdrop:hover {
  background-color: {{sidebarhl}}; background-image: none; color: {{hltext}}; opacity: 1; }


/* Thunar draws its own status bar at the window edge: undo the GTK3 flat-surfaces bottom padding (set-flat-surfaces.sh) */
window.background:not(.popup):not(.tooltip) > box,
window.background:not(.popup):not(.tooltip) > grid,
window.background:not(.popup):not(.tooltip) > paned,
window.background:not(.popup):not(.tooltip) > overlay,
window.background:not(.popup):not(.tooltip) > stack,
window.background:not(.popup):not(.tooltip) > notebook,
window.background:not(.popup):not(.tooltip) > alignment,
window.background:not(.popup):not(.tooltip) > fixed { padding-bottom: 0; }
/* the very faint split-view pane divider: the global flat-surfaces block (user priority, loaded first) makes every separator transparent, so Thunar's own divider rule is repeated here, after it */
paned > separator, paned > separator.wide, paned > separator:backdrop, window.maximized paned > separator, window.fullscreen paned > separator { background-color: {{divider}}; background-image: image({{divider}}); }
/* Thunar keeps ITS accent on scrollbars: the global gtk-scrollbar block (user priority, GTK accent) would otherwise override Thunar's own scrollbar rules */
scrollbar slider, scrollbar slider:hover, scrollbar slider:hover:active, scrollbar.overlay-indicator:not(.dragging):not(.hovering) slider { background-color: {{accent}}; }
/* idle indicator 0.7 (stock 0.4), hovered/dragged 1 (stock GTK3 0.8), with an opacity transition so the fade stays */
scrollbar.overlay-indicator:not(.dragging):not(.hovering) { opacity: 0.7; }
scrollbar.overlay-indicator.dragging, scrollbar.overlay-indicator.hovering { opacity: 1; }
scrollbar.overlay-indicator { transition: opacity 250ms ease-in-out; }
/* inactive window: Thunar's title bar keeps its own colour (the global inactive-titlebar block forces the stock @headerbar_bg_color, one step lighter) */
headerbar:backdrop, .titlebar:backdrop:not(headerbar) { background-color: {{titlebar}}; }
