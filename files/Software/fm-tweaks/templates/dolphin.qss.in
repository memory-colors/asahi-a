/* QStatusBar fix (Gwenview) - the bottom status bar and its child
   toolbuttons/comboboxes ("Show Thumbnails", the "Fit" dropdown, folder/
   info icons) render with default light/white Qt styling, not inheriting
   the dark palette at all - same class of gap as KFilePlacesView below.
   Added 2026-09-28. Also applies to Dolphin/Konsole's own status bars via
   this shared file, in case they have the same unnoticed issue. */
QStatusBar {
    background-color: {{statusbar}};
}
QStatusBar QToolButton,
QStatusBar QPushButton,
QStatusBar QComboBox {
    background-color: #4b4b53;
    color: white;
    border: none;
}
QStatusBar QToolButton:hover,
QStatusBar QPushButton:hover,
QStatusBar QComboBox:hover {
    background-color: #5a5a63;
}

/* KFilePlacesView background fix - the sidebar (Places panel) doesn't
   respond to any standard kdeglobals/qt6ct palette role (confirmed via
   extensive testing 2026-09-20 on this machine), matching a real,
   independently-confirmed finding from the Debian side of this same
   project: KFilePlacesView bypasses normal palette-based background
   painting, and can only be set directly via QSS.
   #37373d matches this system's own qt6ct "Window" palette value. */
KFilePlacesView {
    background: {{sidebar}};
}

/* Sidebar-specific selection color: tried and abandoned 2026-09-20. Neither
   `KFilePlacesView::item:selected` nor `KFilePlacesView
   QAbstractItemView::item:selected` had any visible effect - confirmed
   dead end, this widget's selection highlight isn't reachable via QSS
   (same class of limitation as the KUrlNavigator background dead-end from
   the Debian investigation). Selection color is unified with the main
   window via bluegrey.colors' Colors:Selection instead. */

/* Dolphin path (breadcrumb) bar and status bar - ported from the Debian setup
   (DolphinUrlNavigator = the real container, DolphinStatusBar = a custom widget,
   not QStatusBar, so it needs its own selector). Without these they inherit
   bluegrey.colors' View (#1e1e21) and Window (#2c2c31). Added 2026-10-03. */
DolphinUrlNavigator {
    background: {{pathbar}};
    border: none;
}
DolphinUrlNavigator QWidget {
    background: {{pathbar}};
}
DolphinStatusBar,
DolphinStatusBar QLabel {
    background: {{statusbar}};
    font-size: 10pt;
}
/* KNOMADIC: dolphin-zoom-slider BEGIN
   Status-bar zoom slider. Breeze draws the groove as WindowText@20% over Window (= #454549); QSS is the only way to change it
   without rebuilding the patched Breeze. Groove = disk-bar track #1b1b1d, no outline, filled part = highlight #5a3e8b,
   handle = near-black #161618 with a #3e3e3f ring (colours sampled from a screenshot). Sizes are logical px (screen was ~2x).
   To revert to Breeze's own drawing: delete this block (BEGIN..END). */
DolphinStatusBar QSlider::groove:horizontal {
    height: 6px;
    background: {{track}};
    border: none;
    border-radius: 3px;
}
DolphinStatusBar QSlider::sub-page:horizontal {
    height: 6px;
    background: {{accent}};
    border: none;
    border-radius: 3px;
}
DolphinStatusBar QSlider::handle:horizontal {
    width: 12px;
    height: 12px;
    margin: -4px 0;
    background: {{handle}};
    border: 1px solid #3e3e3f;
    border-radius: 7px;
}
/* KNOMADIC: dolphin-zoom-slider END */
/* Disk-usage widget: font only, no background (it paints its own bar). */
StatusBarSpaceInfo,
StatusBarSpaceInfo *,
KCapacityBar {
    font-size: 10pt;
}
/* Shorter disk-usage bar (8px; was ~18px). */
KCapacityBar {
    min-height: 8px;
    max-height: 8px;
}

/* Smaller text on the path bar (general font is 14pt; 1.5pt smaller). The
   breadcrumb buttons are KDEPrivate::KUrlNavigatorButton - QSS needs "--" in
   place of "::". The Name/Size/Modified header is a QGraphicsWidget painted by
   Dolphin itself, so QSS cannot size it. Added 2026-10-03. */
DolphinUrlNavigator,
KUrlNavigator,
KDEPrivate--KUrlNavigatorButton,
KDEPrivate--KUrlNavigatorDropDownButton,
KUrlComboBox,
KUrlComboBox QLineEdit,
KUrlComboBox QAbstractItemView {
    font-size: 10pt;
}

/* Text colors (dolphin-tweaks.conf [text]): status bar labels + disk-usage text (a QToolButton in StatusBarSpaceInfo), Places panel, path bar (breadcrumbs here; the edit-mode text is set by the shim, urlbar.cpp). */
DolphinStatusBar QLabel {
    color: {{statustext}};
}
StatusBarSpaceInfo QToolButton {
    color: {{disktext}};
}
KFilePlacesView {
    color: {{sidebartext}};
}
KDEPrivate--KUrlNavigatorButton,
KDEPrivate--KUrlNavigatorDropDownButton {
    color: {{urltext}};
}
