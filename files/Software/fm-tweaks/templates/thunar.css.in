/* fm-sample (Thunar/Nemo look): GENERATED by fm-tweaks from templates/thunar.css.in + ~/.config/fm-tweaks/fm-tweaks.conf - edit those, not this file.
   Standalone theme, only active with GTK_THEME=fm-sample (global gtk.css untouched). */
@import url("file:///usr/share/themes/adw-gtk3-dark/gtk-3.0/gtk.css");
@define-color accent_bg_color {{accent}};
@define-color accent_color {{accent}};
@define-color theme_selected_bg_color {{accent}};
@define-color selected_bg_color {{accent}};
@define-color headerbar_bg_color {{titlebar}};
@define-color window_bg_color {{window}};
@define-color view_bg_color {{view}};
@define-color theme_bg_color {{window}};
@define-color theme_base_color {{view}};
@define-color theme_fg_color {{text}};
@define-color theme_text_color {{text}};
@define-color insensitive_fg_color {{statustext}};

window, .background { background-color: {{window}}; color: {{text}}; }
headerbar, .titlebar, toolbar, menubar { background-color: {{window}}; color: {{text}}; box-shadow: none; border-image: none; border-color: {{window}}; }
/* Places sidebar */
.sidebar, .sidebar row, placessidebar, placessidebar list { background-color: {{sidebar}}; color: {{sidebartext}}; }
/* file view + path/status area */
.view, iconview, treeview.view, textview text, .nemo-window .view { background-color: {{view}}; color: {{text}}; }
statusbar, .nemo-window statusbar { background-color: {{view}}; color: {{statustext}}; }
/* flat selection / hover, 5px ends */
.view:selected, iconview:selected, treeview.view:selected, row:selected, .sidebar row:selected { background-color: {{accent}}; color: {{hltext}}; border-radius: 5px; }
treeview.view:hover, .sidebar row:hover { background-color: alpha({{accent}}, 0.35); border-radius: 5px; }
/* detail view: GTK3 paints each COLUMN's cell separately, so a CSS radius would also round the joins between Name | Size | Modified (notches). hooks.so rounds the row's outer ends instead. */
.standard-view treeview.view:selected, .standard-view treeview.view:hover, .standard-view treeview.view:selected:hover, .standard-view treeview.view:selected:focus, .standard-view treeview.view:selected:backdrop { border-radius: 0; }
treeview.view header button { background-color: {{window}}; color: {{text}}; border-color: {{window}}; }
/* menus: {{window}}, 10px menu, 5px highlight */
menu, .menu, .popup, popover, popover.background { background-color: {{tooltip}}; color: {{text}}; border: 1px solid #45454d; border-radius: 10px; padding: 2px 2px; }
menuitem { border-radius: 5px; padding: 2px 10px; min-height: 0; }
menuitem:hover, menuitem:selected { background-color: {{accent}}; color: {{hltext}}; }

/* sidebar: lighter gray everywhere inside it, every icon a plain white folder (Nemo/GtkPlacesSidebar; Thunar's tree sidebar draws icons via cell renderers, which CSS cannot swap) */
.sidebar, .sidebar > *, .sidebar scrolledwindow, .sidebar viewport, .sidebar list, .sidebar row, .sidebar treeview, .sidebar treeview.view,
placessidebar, placessidebar > *, placessidebar viewport, placessidebar list, placessidebar row,
.nemo-places-sidebar, .nemo-places-sidebar > *, .nemo-places-sidebar viewport, .nemo-places-sidebar treeview.view,
paned > separator ~ * .sidebar { background-color: {{sidebar}}; color: {{sidebartext}}; }
.sidebar row:selected, placessidebar row:selected, .sidebar treeview.view:selected { background-color: {{sidebarhl}}; color: {{hltext}}; }
.sidebar image, placessidebar row image, .sidebar row image, .nemo-places-sidebar image {
    -gtk-icon-source: -gtk-icontheme("folder-symbolic"); -gtk-icon-style: symbolic; color: white; }

/* Thunar: no tree lines / grid lines, slimmer toolbar */
treeview.view, treeview { -GtkTreeView-tree-line-width: 0; -GtkTreeView-grid-line-width: 0; -GtkTreeView-expander-size: 20; }
treeview.view.expander { -gtk-icon-source: -gtk-icontheme("pan-end-symbolic"); color: {{statustext}}; }
treeview.view.expander:checked { -gtk-icon-source: -gtk-icontheme("pan-down-symbolic"); }
toolbar { padding: 0 4px; min-height: 0; }
toolbar button, toolbar .button { min-height: 22px; min-width: 22px; padding: 2px 4px; margin: 0; }
toolbar separator { margin: 4px 2px; }

/* hide window title text (CSD titlebar), tighter location bar */
.titlebar .title, headerbar .title, headerbar label.title, .titlebar label { opacity: 0; font-size: 0; }
toolbar entry, toolbar .linked button, toolbar button { min-height: 20px; padding-top: 1px; padding-bottom: 1px; }

/* titlebar = its own {{titlebar}} swatch (Knomadic: Thunar Colors > Titlebar; follows Button until set) */
headerbar, .titlebar, decoration .titlebar { background-color: {{titlebar}}; background-image: none; border-color: {{titlebar}}; }
toolbar entry, toolbar .linked button, toolbar button { min-height: 16px; padding-top: 0; padding-bottom: 0; }

/* expander arrows: +4px breathing room each side; column header row = view bg, thin */
treeview.view.expander { min-width: 20px; min-height: 16px; padding-left: 3px; padding-right: 3px; }
treeview.view header button, treeview header button { background-color: {{view}}; background-image: none; border-color: {{view}}; box-shadow: none; min-height: 0; padding: 1px 6px; color: {{statustext}}; }
treeview.view header button:hover { background-color: {{view}}; color: {{text}}; }

/* adw-gtk3 extends the pane-drag hit area 8px into the right pane (over the expander arrows); shrink to 2px */
paned.horizontal > separator:dir(ltr) { margin: 0 -2px 0 0; padding: 0 2px 0 0; }
paned.horizontal > separator:dir(rtl) { margin: 0 0 0 -2px; padding: 0 0 0 2px; }

/* gap between the sidebar divider and the file list (view-colored so it reads as list padding) */
paned.horizontal > scrolledwindow:last-child, paned.horizontal > box:last-child, paned.horizontal > notebook:last-child { border-left: 8px solid {{view}}; background-color: {{view}}; }

/* real target (from the live widget tree): the file list is notebook > scrolledwindow.standard-view */
notebook scrolledwindow.frame.standard-view, scrolledwindow.standard-view { border-left: 8px solid {{view}}; border-top: 0; border-right: 0; border-bottom: 0; background-color: {{view}}; }

/* WORKS (verified by screenshot): borders on this scrolledwindow are ignored, margin is not; the gap shows the notebook behind it */


/* bigger expander hit area: wider+taller cell, arrow centered in it (no strip) */
treeview.view.expander { min-width: 20px; min-height: 20px; padding: 0 1px 0 3px; }

/* toolbar + location bar = view bg; column header row = button color (view - 6,6,8) */
toolbar, .thunar toolbar, window.thunar grid > toolbar { background-color: {{view}}; background-image: none; }
toolbar entry, toolbar .path-bar, toolbar .path-bar button, toolbar entry:focus { background-color: {{view}}; background-image: none; color: {{text}}; border-color: {{window}}; box-shadow: none; }
treeview.view header button, treeview header button, treeview.view header button:hover { background-color: {{button}}; border-color: {{button}}; color: {{text}}; }

/* hide the "..." menu toggle (first toolbar button; shown whenever the menubar is hidden - Ctrl+M still toggles it) */
toolbar > toolbutton:first-child, toolbar > toolbutton:first-child button { min-width: 0; min-height: 0; padding: 0; margin: 0; border: none; opacity: 0; }
toolbar > toolbutton:first-child image { -gtk-icon-source: none; min-width: 0; min-height: 0; margin: 0; }

/* Name/Size/Type bar = view bg; location box ~3/4 width (CSS has no percentages: fixed right margin) */
treeview.view header button, treeview header button, treeview.view header button:hover { background-color: {{view}}; border-color: {{view}}; }
toolbar toolitem > widget > box { margin-right: 155px; }

/* no outline on the location box */
toolbar entry, toolbar entry:focus, toolbar toolitem > widget > box, toolbar .path-bar, toolbar .path-bar button { border: none; border-color: transparent; box-shadow: none; outline: none; }

/* Name/Size/Type bar a little taller (was 1px vertical padding) */
treeview.view header button, treeview header button { padding: 4px 6px; }

/* inactive window: titlebar keeps its color, traffic lights vanish */
headerbar:backdrop, .titlebar:backdrop, decoration:backdrop .titlebar, window:backdrop .titlebar { background-color: {{titlebar}}; background-image: none; border-color: {{titlebar}}; color: {{titlebar}}; }
headerbar:backdrop button, .titlebar:backdrop button, .titlebar:backdrop .titlebutton, headerbar:backdrop .titlebutton, window:backdrop .titlebar button { opacity: 0; }

/* Name/Size/Type bar = {{button}} (final) */
treeview.view header button, treeview header button, treeview.view header button:hover { background-color: {{button}}; border-color: {{button}}; }

/* sidebar section headings (Places / Devices) regular weight */
.shortcuts-pane treeview, .shortcuts-pane treeview.view, .sidebar treeview.view { font-weight: 400; }

/* hidden "..." still reserves 35px; pull the neighbours left over it */

/* higher-specificity collapse of the hidden "..." button (adw's .flat.image-button padding outranked the earlier rule) */
toolbar > toolbutton:first-child > button.flat.image-button.toggle, toolbar > toolbutton:first-child > button.image-button.toggle:not(:hover) { min-width: 0; min-height: 0; padding: 0; margin: 0; border: none; }
toolbar > toolbutton:first-child > button.flat.image-button.toggle > image { min-width: 0; min-height: 0; padding: 0; margin: 0; -gtk-icon-source: none; }

/* the hidden "..." button keeps its 35px footprint no matter what CSS says; slide the toolbar left so it hangs off the window edge and Back/Up take its place */
grid > toolbar { margin-left: -31px; }

/* keep the bar color but not outside the window: paint it on the grid, not on the shifted toolbar */
window > grid { background-color: {{view}}; }
grid > toolbar { background-color: transparent; }


/* indent per tree level = expander cell width: ~half of before (22 -> 12) so children sit "halfway" under the parent; height stays tall for clicking */
treeview.view { -GtkTreeView-expander-size: 10; }
treeview.view.expander { min-width: 8px; min-height: 22px; padding: 0 1px 0 3px; }

/* arrow breathing room that does NOT change the per-level indent (indent = expander cell width, left alone) */
treeview.view { -GtkTreeView-horizontal-separator: 8; }

/* url/location text = status bar text color */
toolbar entry, toolbar entry:focus, toolbar .path-bar, toolbar .path-bar button { color: {{statustext}}; }
/* scrollbars use the highlight color (vertical + horizontal) */
scrollbar { background-color: transparent; background-image: none; border: none; }
scrollbar trough { background-color: transparent; border: none; }
scrollbar slider, scrollbar slider:hover, scrollbar slider:active, scrollbar.vertical slider, scrollbar.horizontal slider { background-color: {{accent}}; border-color: {{accent}}; }
/* divider between the two split-view panes: barely-there {{divider}} */
paned paned > separator, paned paned > separator.wide { background-color: {{divider}}; background-image: image({{divider}}); }

/* scrollbars: identical in indicator (idle-scroll) and hover/drag states - thin, accent purple, full opacity.
   adw-gtk3 makes the hovered bar ~8px+borders and the idle indicator grey 3px at 0.4 opacity; flatten both to the thin purple look. */
scrollbar.overlay-indicator, scrollbar.overlay-indicator:not(.dragging):not(.hovering), scrollbar.overlay-indicator.hovering, scrollbar.overlay-indicator.dragging { opacity: 1; background-color: transparent; border-color: transparent; }
scrollbar.overlay-indicator.vertical:not(.dragging):not(.hovering) slider, scrollbar.overlay-indicator.vertical.hovering slider, scrollbar.overlay-indicator.vertical.dragging slider,
scrollbar.overlay-indicator.vertical slider:hover, scrollbar.overlay-indicator.vertical slider:hover:active {
  min-width: 3px; margin: 2px 0; border: 1px solid transparent; border-radius: 10px; background-clip: padding-box; background-color: {{accent}}; }
scrollbar.overlay-indicator.horizontal:not(.dragging):not(.hovering) slider, scrollbar.overlay-indicator.horizontal.hovering slider, scrollbar.overlay-indicator.horizontal.dragging slider,
scrollbar.overlay-indicator.horizontal slider:hover, scrollbar.overlay-indicator.horizontal slider:hover:active {
  min-height: 3px; margin: 0 2px; border: 1px solid transparent; border-radius: 10px; background-clip: padding-box; background-color: {{accent}}; }

/* dialogs (e.g. permanent-delete confirm): the default button (Enter) uses the highlight color, others stay grey */
messagedialog button.default, dialog button.default, button.text-button.default, messagedialog button.default:focus, dialog button.default:focus { background-color: {{accent}}; background-image: none; color: {{hltext}}; border-color: {{accent}}; box-shadow: none; }
messagedialog button.default:hover, dialog button.default:hover { background-color: {{accent_hover}}; }

/* every pane divider (sidebar|files as well as file|file) = barely-there {{divider}}, in any window state */
paned > separator, paned > separator.wide, paned > separator:backdrop, window.maximized paned > separator, window.fullscreen paned > separator { background-color: {{divider}}; background-image: image({{divider}}); }

/* overall font is 14pt (thunar-fm keyfile); status bar and location/url text stay 13pt */
statusbar, statusbar label, toolbar entry, toolbar .path-bar button { font-size: 13pt; }

/* menus and combo/popover popups: 2px smaller than the overall font (14pt -> 12.5pt); tooltips unchanged */
menu, .menu, .popup, menuitem, menuitem label, popover, popover label, popover modelbutton { font-size: 12.5pt; }

/* menu / combo / popover selection = the main highlight (adw-gtk3's own hover rule is more specific, so match it) */
menu menuitem:hover, menu menuitem:selected, menu > menuitem:hover, .menu menuitem:hover, .popup menuitem:hover, menuitem:hover, menuitem:selected,
popover modelbutton:hover, popover modelbutton.flat:hover, popover button.flat:hover, popover row:hover, popover row:selected, combobox menu menuitem:hover
  { background-color: {{accent}}; background-image: none; color: {{hltext}}; }
menu menuitem:hover label, menu menuitem:selected label, menuitem:hover label, popover modelbutton:hover label, popover row:selected label { color: {{hltext}}; }

/* tooltips share the menu colour */
tooltip, tooltip.background { background-color: {{tooltip}}; color: {{text}}; border: 1px solid {{tipborder}}; border-radius: 6px; box-shadow: none; }
tooltip label { color: {{text}}; }

/* tighter left/right padding on menus, combo popups, popovers, tooltips */
menu menuitem, .menu menuitem, .popup menuitem { padding-left: 10px; padding-right: 10px; }
menuitem label, menuitem accelerator { margin-left: 0; margin-right: 0; padding-left: 0; padding-right: 0; }
popover modelbutton, popover modelbutton.flat { padding-left: 10px; padding-right: 10px; min-height: 0; }
tooltip.background { padding: 2px 4px; }
tooltip label { margin: 0; padding: 0; }

/* no reserved icon/check column in menus (items here have no icons) */
menu menuitem check, menu menuitem radio, menuitem check:dir(ltr), menuitem radio:dir(ltr) { min-width: 0; min-height: 0; margin: 0; padding: 0; }
menu menuitem image { min-width: 0; min-height: 0; margin: 0; padding: 0; }

/* split view: the 8px view-coloured gap (above) belongs to the sidebar/file-list edge only. On the right pane's left edge it showed up as a lighter band through the
   Name header row; there a thin divider replaces it and the header runs edge to edge in the button colour. */
paned.horizontal paned.horizontal > scrolledwindow:last-child, paned.horizontal paned.horizontal > box:last-child, paned.horizontal paned.horizontal > notebook:last-child { border-left: 1px solid {{divider}}; background-color: {{view}}; }
/* native GTK3 message dialogs (permanent-delete confirm...) styled like the zenity/AdwMessageDialog ones (thunar-gtk4.css.in): menu colour, one 12.5pt text size, 8px buttons, no icon / titlebar */
messagedialog.background.background, messagedialog.background.background decoration, messagedialog.background.background box, messagedialog.background.background .message-area, dialog.message { background-color: {{tooltip}}; background-image: none; color: {{text}}; }
messagedialog.background.background { min-width: 300px; }
messagedialog .titlebar, messagedialog headerbar, messagedialog.background.background headerbar { min-height: 0; margin: 0; padding: 0; opacity: 1; background-color: {{tooltip}}; background-image: none; border: none; box-shadow: none; }
messagedialog .titlebar *, messagedialog headerbar * { min-height: 0; min-width: 0; margin: 0; padding: 0; opacity: 0; }
messagedialog image { opacity: 0; min-width: 0; min-height: 0; margin: 0; padding: 0; }
messagedialog label, messagedialog .title, messagedialog label.title { font-size: 12.5pt; font-weight: normal; color: {{text}}; }
messagedialog.background .dialog-action-area button, messagedialog.background actionbar button { margin: 0 4px; padding: 4px 10px; min-height: 0; border-radius: 8px; background-image: none; background-color: {{button}}; color: {{buttontext}}; border: none; box-shadow: none; }
messagedialog.background .dialog-action-area button:hover { background-color: shade({{button}}, 1.25); }
messagedialog.background .dialog-action-area button.default, messagedialog.background .dialog-action-area button:focus { background-color: {{accent}}; color: {{hltext}}; }
messagedialog.background .dialog-action-area button.default:hover { background-color: shade({{accent}}, 1.15); }
messagedialog .message-area label, messagedialog label.title { min-width: 300px; }
/* all dialogs: the menu/tooltip dark grey instead of the near-black titlebar + the lighter window grey */
dialog.background, dialog.background.csd, dialog.background decoration { background-color: {{tooltip}}; background-image: none; }
dialog headerbar, dialog headerbar:backdrop, dialog .titlebar, dialog .titlebar:backdrop, dialog.csd headerbar { background-color: {{tooltip}}; background-image: none; border-color: {{tooltip}}; color: {{text}}; }
dialog box.dialog-vbox, dialog .dialog-action-area, dialog actionbar { background-color: transparent; }

/* drop indicator while dragging (sidebar reorder / drop-into): GTK draws it as the outline of the treeview's "dnd" node; the stock dashed -3px outline looked like a dark smudge on a 2px line */
treeview.view.dnd, treeview.view.dnd:selected, treeview.view.dnd:hover, iconview.dnd { outline-style: solid; outline-width: 2px; outline-offset: 0; outline-color: alpha({{text}}, 0.75); -gtk-outline-radius: 0; background-color: transparent; background-image: none; box-shadow: none; }
