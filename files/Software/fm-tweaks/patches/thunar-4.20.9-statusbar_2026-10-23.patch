+static guint64
+thunar_util_folder_size_recursive (GFile *root, GCancellable *cancellable)
+{
+  guint64 total = 0;
+  GQueue  queue = G_QUEUE_INIT;
+  guint64 n = 0;
+
+  g_queue_push_tail (&queue, g_object_ref (root));
+  while (!g_queue_is_empty (&queue) && n < 3000000 && !g_cancellable_is_cancelled (cancellable))
+    {
+      GFile           *dir = g_queue_pop_head (&queue);
+      GFileEnumerator *en = g_file_enumerate_children (dir, "standard::name,standard::type,standard::size", G_FILE_QUERY_INFO_NOFOLLOW_SYMLINKS, cancellable, NULL);
+      GFileInfo       *fi;
+
+      while (en != NULL && (fi = g_file_enumerator_next_file (en, cancellable, NULL)) != NULL)
+        {
+          n++;
+          if (g_file_info_get_file_type (fi) == G_FILE_TYPE_DIRECTORY)
+            g_queue_push_tail (&queue, g_file_get_child (dir, g_file_info_get_name (fi)));
