+// Full-quality decode of a raw file whose embedded preview is on screen; swaps in when done
+void QVImageCore::startRawUpgrade(const QString &filePath, const QColorSpace &targetColorSpace)
+{
+    if (rawUpgradesInProgress.contains(filePath))
+        return;
+    rawUpgradesInProgress.append(filePath);
+
+    auto *watcher = new QFutureWatcher<ReadData>();
+    connect(watcher, &QFutureWatcher<ReadData>::finished, this, [watcher, filePath, this](){
+        ReadData full = watcher->result();
+        rawUpgradesInProgress.removeAll(filePath);
+        watcher->deleteLater();
+        if (full.errorData.hasError || full.image.isNull())
+            return;
+
+        if (currentFileDetails.isPixmapLoaded && currentFileDetails.fileInfo.absoluteFilePath() == filePath)
+        {
+            const QSize oldSize = loadedPixmap.size();
+            loadedPixmap = QPixmap::fromImage(matchCurrentRotation(full.image));
+            currentFileDetails.loadedPixmapSize = loadedPixmap.size();
+            currentFileDetails.baseImageSize = full.imageSize.isValid() ? full.imageSize : loadedPixmap.size();
+            addToCache(std::move(full));
+            emit rawPreviewUpgraded(oldSize, loadedPixmap.size());
+        }
+        else
+        {
+            // user moved on: still keep the good version cached
+            addToCache(std::move(full));
+        }
+    });
+    watcher->setFuture(QtConcurrent::run(&QVImageCore::readFileInternal, this, filePath, targetColorSpace, false));
+}
