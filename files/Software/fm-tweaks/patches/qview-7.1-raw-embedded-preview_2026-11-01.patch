+// Swap the embedded raw preview for the full decode without disturbing zoom/pan:
+// the item grows by k in pixels, so every view transform shrinks by k.
+void QVGraphicsView::onRawPreviewUpgraded(QSize oldSize, QSize newSize)
+{
+    if (oldSize.isEmpty() || newSize.isEmpty())
+        return;
+    const qreal kx = qreal(newSize.width()) / oldSize.width();
+    const qreal ky = qreal(newSize.height()) / oldSize.height();
+
+    const QPointF centre = mapToScene(viewport()->rect().center());
+
+    auto shrink = [kx, ky](const QTransform &t) {
+        return QTransform(t.m11() / kx, t.m12(), t.m21(), t.m22() / ky, t.dx(), t.dy());
+    };
+
+    loadedPixmapItem->setPixmap(getLoadedPixmap());
+    scaledSize = loadedPixmapItem->boundingRect().size().toSize();
+    setTransform(shrink(transform()));
+    absoluteTransform = shrink(absoluteTransform);
+    zoomBasis = shrink(zoomBasis);
+    centerOn(QPointF(centre.x() * kx, centre.y() * ky));
+
+    if (isScalingEnabled)
+        expensiveScaleTimerNew->start();
+
+    emit updatedLoadedPixmapItem();
+}
 
