+
+// Pull the camera's embedded JPEG out of a raw file (fast; avoids a full LibRaw decode).
+// Returns a null image if the file isn't raw or has no usable JPEG preview.
+static QImage readRawEmbeddedPreview(const QString &fileName)
+{
+    static const QStringList rawSuffixes = {
+        "raf", "arw", "dng", "cr2", "cr3", "crw", "nef", "nrw", "orf", "rw2", "pef", "srw",
+        "sr2", "srf", "raw", "rwl", "3fr", "erf", "kdc", "dcr", "mef", "mos", "mrw", "x3f", "iiq"
+    };
+    if (!rawSuffixes.contains(QFileInfo(fileName).suffix().toLower()))
+        return QImage();
+
+    LibRaw raw;
+    if (raw.open_file(QFile::encodeName(fileName).constData()) != LIBRAW_SUCCESS)
+        return QImage();
+    if (raw.unpack_thumb() != LIBRAW_SUCCESS)
+        return QImage();
+    if (raw.imgdata.thumbnail.tformat != LIBRAW_THUMBNAIL_JPEG || raw.imgdata.thumbnail.tlength == 0)
+        return QImage();
+
+    QByteArray jpeg(raw.imgdata.thumbnail.thumb, static_cast<int>(raw.imgdata.thumbnail.tlength));
+    QBuffer buffer(&jpeg);
+    buffer.open(QIODevice::ReadOnly);
+    QImageReader reader(&buffer, "jpeg");
+    reader.setAutoTransform(true);
+    bool hasExifOrientation = reader.transformation() != QImageIOHandler::TransformationNone;
+    QImage image = reader.read();
+    if (image.isNull())
+        return QImage();
+
+    // Preview carries no orientation of its own: use the raw file's
+    if (!hasExifOrientation)
+    {
+        QTransform t;
+        switch (raw.imgdata.sizes.flip)
+        {
+        case 3: t.rotate(180); break;
+        case 5: t.rotate(-90); break;
+        case 6: t.rotate(90); break;
+        default: break;
+        }
+        if (!t.isIdentity())
+            image = image.transformed(t);
+    }
+    return image;
+}
