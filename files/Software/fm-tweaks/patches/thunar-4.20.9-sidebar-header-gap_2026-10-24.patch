+/* FM-TWEAKS: header rows other than the first start with a small blank line (about 16 px) so the groups are visually separated */
+static void
+thunar_shortcuts_view_header_data_func (GtkTreeViewColumn *column,
+                                        GtkCellRenderer   *renderer,
+                                        GtkTreeModel      *model,
+                                        GtkTreeIter       *iter,
+                                        gpointer           data)
+{
+  GtkTreePath *path;
+  gboolean     is_header;
+  gchar       *name = NULL;
+  gint         first;
+
+  gtk_tree_model_get (model, iter, THUNAR_SHORTCUTS_MODEL_COLUMN_IS_HEADER, &is_header, THUNAR_SHORTCUTS_MODEL_COLUMN_NAME, &name, -1);
+  if (!is_header || name == NULL)
+    {
+      g_free (name);
+      return;
+    }
+
+  path = gtk_tree_model_get_path (model, iter);
+  first = gtk_tree_path_get_indices (path)[0] == 0;
+  gtk_tree_path_free (path);
+
+  /* FM-TWEAKS: Semibold weight (the static SF Pro faces are separate families, so this selects "SF Pro Semibold" instead of asking for a weight), and the
+   * header text starts at the left edge of the item icons: indent cell 2*6 + column spacing 2, plus 1 for the glyph side bearing; indent cell is 2*4 (sidebar pushed left 4 px) */
+  g_object_set (renderer, "family", "SF Pro Semibold", "weight", PANGO_WEIGHT_NORMAL, "xpad", 11, NULL);
+
+  if (first)
+    g_object_set (renderer, "text", name, NULL);
+  else
+    {
+      gchar *escaped = g_markup_escape_text (name, -1);
+      gchar *markup = g_strdup_printf ("<span size=\"10240\"> </span>\n%s", escaped);
+      g_object_set (renderer, "markup", markup, NULL);
+      g_free (markup);
+      g_free (escaped);
+    }
+  g_free (name);
+}
