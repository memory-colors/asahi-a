+static void
+trd_preset_delete (GtkMenuItem         *item,
+                   ThunarRenamerDialog *renamer_dialog)
+{
+  const gchar *name = g_object_get_data (G_OBJECT (item), "preset-name");
+  XfceRc      *rc;
+  gchar       *group;
+
+  if (name == NULL)
+    return;
+  rc = xfce_rc_config_open (XFCE_RESOURCE_CONFIG, "Thunar/renamerrc", FALSE);
+  if (rc == NULL)
+    return;
+  group = g_strconcat (TRD_PRESET_PREFIX, name, NULL);
+  xfce_rc_delete_group (rc, group, TRUE);
+  g_free (group);
+  xfce_rc_close (rc);
+}
