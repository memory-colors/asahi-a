+static void
+trd_preset_save (GtkMenuItem         *item,
+                 ThunarRenamerDialog *renamer_dialog)
+{
+  ThunarxRenamer *renamer;
+  GHashTable     *settings;
+  GEnumClass     *klass;
+  GEnumValue     *value;
+  GtkWidget      *dialog;
+  GtkWidget      *entry;
+  GtkWidget      *box;
+  XfceRc         *rc;
+  gchar          *name;
+  gchar          *group;
+
+  renamer = thunar_renamer_model_get_renamer (renamer_dialog->model);
+  if (renamer == NULL)
+    return;
+
+  dialog = gtk_dialog_new_with_buttons (_("Save Preset"), GTK_WINDOW (renamer_dialog),
+                                        GTK_DIALOG_MODAL | GTK_DIALOG_DESTROY_WITH_PARENT,
+                                        _("_Cancel"), GTK_RESPONSE_CANCEL,
+                                        _("_Save"), GTK_RESPONSE_ACCEPT, NULL);
+  gtk_dialog_set_default_response (GTK_DIALOG (dialog), GTK_RESPONSE_ACCEPT);
+  box = gtk_dialog_get_content_area (GTK_DIALOG (dialog));
+  gtk_container_set_border_width (GTK_CONTAINER (box), 12);
+  gtk_box_set_spacing (GTK_BOX (box), 6);
+  gtk_box_pack_start (GTK_BOX (box), gtk_label_new (_("Preset name (saves the current rename operation, its settings and the mode):")), FALSE, FALSE, 0);
+  entry = gtk_entry_new ();
+  gtk_entry_set_activates_default (GTK_ENTRY (entry), TRUE);
+  gtk_box_pack_start (GTK_BOX (box), entry, FALSE, FALSE, 0);
+  gtk_widget_show_all (box);
+
+  if (gtk_dialog_run (GTK_DIALOG (dialog)) != GTK_RESPONSE_ACCEPT)
+    {
+      gtk_widget_destroy (dialog);
+      return;
+    }
+  name = g_strstrip (g_strdup (gtk_entry_get_text (GTK_ENTRY (entry))));
+  gtk_widget_destroy (dialog);
+
+  if (*name == '\0' || strpbrk (name, "[]/") != NULL)
+    {
+      g_free (name);
+      return;
+    }
+
+  rc = xfce_rc_config_open (XFCE_RESOURCE_CONFIG, "Thunar/renamerrc", FALSE);
+  if (rc == NULL)
+    {
+      g_free (name);
+      return;
+    }
+  group = g_strconcat (TRD_PRESET_PREFIX, name, NULL);
+
+  /* never replace an existing preset silently: Enter = Cancel */
+  if (xfce_rc_has_group (rc, group))
+    {
+      dialog = gtk_message_dialog_new (GTK_WINDOW (renamer_dialog), GTK_DIALOG_MODAL, GTK_MESSAGE_QUESTION, GTK_BUTTONS_NONE,
+                                       _("A preset named \"%s\" already exists. Replace it?"), name);
+      gtk_dialog_add_button (GTK_DIALOG (dialog), _("Replace"), GTK_RESPONSE_ACCEPT);
+      gtk_dialog_add_button (GTK_DIALOG (dialog), _("_Cancel"), GTK_RESPONSE_CANCEL);
+      gtk_dialog_set_default_response (GTK_DIALOG (dialog), GTK_RESPONSE_CANCEL);
+      if (gtk_dialog_run (GTK_DIALOG (dialog)) != GTK_RESPONSE_ACCEPT)
+        {
+          gtk_widget_destroy (dialog);
+          xfce_rc_close (rc);
+          g_free (group);
+          g_free (name);
+          return;
+        }
+      gtk_widget_destroy (dialog);
+    }
+
+  xfce_rc_delete_group (rc, group, TRUE);
+  xfce_rc_set_group (rc, group);
+  xfce_rc_write_entry (rc, "_Renamer", G_OBJECT_TYPE_NAME (renamer));
+  klass = g_type_class_ref (THUNAR_TYPE_RENAMER_MODE);
+  value = g_enum_get_value (klass, thunar_renamer_model_get_mode (renamer_dialog->model));
+  if (value != NULL)
+    xfce_rc_write_entry (rc, "_Mode", value->value_name);
+  g_type_class_unref (klass);
+
+  settings = g_hash_table_new_full (g_str_hash, g_str_equal, g_free, g_free);
+  thunarx_renamer_save (renamer, settings);
+  g_hash_table_foreach (settings, trd_save_foreach, rc);
+  g_hash_table_destroy (settings);
+
+  xfce_rc_close (rc);
+  g_free (group);
+  g_free (name);
+}
