+/* ---- presets: groups "Preset:<name>" in Thunar/renamerrc; keys "_Renamer", "_Mode" + the renamer's own settings ---- */
+
+#define TRD_PRESET_PREFIX "Preset:"
+
+static void
+trd_preset_apply (GtkMenuItem         *item,
+                  ThunarRenamerDialog *renamer_dialog)
+{
+  const gchar *name = g_object_get_data (G_OBJECT (item), "preset-name");
+  GHashTable  *settings;
+  GEnumClass  *klass;
+  const gchar *renamer_type;
+  const gchar *mode_str;
+  GtkWidget   *page;
+  XfceRc      *rc;
+  gchar      **entries;
+  gchar       *group;
+  guint        n;
+  gint         i;
+
+  if (name == NULL || renamer_dialog->notebook == NULL)
+    return;
+
+  rc = xfce_rc_config_open (XFCE_RESOURCE_CONFIG, "Thunar/renamerrc", TRUE);
+  if (rc == NULL)
+    return;
+
+  group = g_strconcat (TRD_PRESET_PREFIX, name, NULL);
+  if (xfce_rc_has_group (rc, group))
+    {
+      entries = xfce_rc_get_entries (rc, group);
+      xfce_rc_set_group (rc, group);
+      renamer_type = xfce_rc_read_entry_untranslated (rc, "_Renamer", "");
+      mode_str = xfce_rc_read_entry_untranslated (rc, "_Mode", "");
+
+      settings = g_hash_table_new (g_str_hash, g_str_equal);
+      for (n = 0; entries != NULL && entries[n] != NULL; ++n)
+        if (entries[n][0] != '_')
+          g_hash_table_insert (settings, entries[n], (gchar *) xfce_rc_read_entry_untranslated (rc, entries[n], NULL));
+
+      /* select the renamer and let it load the preset settings */
+      for (i = 0; (page = gtk_notebook_get_nth_page (GTK_NOTEBOOK (renamer_dialog->notebook), i)) != NULL; ++i)
+        if (g_strcmp0 (G_OBJECT_TYPE_NAME (page), renamer_type) == 0)
+          {
+            gtk_combo_box_set_active (GTK_COMBO_BOX (renamer_dialog->rcombo), i);
+            thunarx_renamer_load (THUNARX_RENAMER (page), settings);
+            break;
+          }
+
+      /* restore the mode (name / extension / both) */
+      klass = g_type_class_ref (THUNAR_TYPE_RENAMER_MODE);
+      for (n = 0; n < klass->n_values; ++n)
+        if (g_strcmp0 (mode_str, klass->values[n].value_name) == 0)
+          {
+            gtk_combo_box_set_active (GTK_COMBO_BOX (renamer_dialog->mode_combo), n);
+            break;
+          }
+      g_type_class_unref (klass);
+
+      g_hash_table_destroy (settings);
+      g_strfreev (entries);
+    }
+  g_free (group);
+  xfce_rc_close (rc);
+}
