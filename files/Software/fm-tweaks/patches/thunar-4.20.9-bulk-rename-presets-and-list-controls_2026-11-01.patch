+static gint
+trd_preset_cmp (gconstpointer a,
+                gconstpointer b)
+{
+  return g_utf8_collate (*(const gchar *const *) a, *(const gchar *const *) b);
+}
+
+
+
+static void
+thunar_renamer_dialog_presets_clicked (GtkWidget           *button,
+                                       ThunarRenamerDialog *renamer_dialog)
+{
+  GtkWidget *menu, *item, *sub;
+  XfceRc    *rc;
+  gchar    **groups;
+  GPtrArray *names;
+  guint      n;
+
+  names = g_ptr_array_new_with_free_func (g_free);
+  rc = xfce_rc_config_open (XFCE_RESOURCE_CONFIG, "Thunar/renamerrc", TRUE);
+  if (rc != NULL)
+    {
+      groups = xfce_rc_get_groups (rc);
+      for (n = 0; groups != NULL && groups[n] != NULL; ++n)
+        if (g_str_has_prefix (groups[n], TRD_PRESET_PREFIX))
+          g_ptr_array_add (names, g_strdup (groups[n] + strlen (TRD_PRESET_PREFIX)));
+      g_strfreev (groups);
+      xfce_rc_close (rc);
+    }
+  g_ptr_array_sort (names, trd_preset_cmp);
+
+  menu = gtk_menu_new ();
+  for (n = 0; n < names->len; ++n)
+    {
+      item = gtk_menu_item_new_with_label (g_ptr_array_index (names, n));
+      g_object_set_data_full (G_OBJECT (item), "preset-name", g_strdup (g_ptr_array_index (names, n)), g_free);
+      g_signal_connect (item, "activate", G_CALLBACK (trd_preset_apply), renamer_dialog);
+      gtk_menu_shell_append (GTK_MENU_SHELL (menu), item);
+    }
+  if (names->len == 0)
+    {
+      item = gtk_menu_item_new_with_label (_("(no presets yet)"));
+      gtk_widget_set_sensitive (item, FALSE);
+      gtk_menu_shell_append (GTK_MENU_SHELL (menu), item);
+    }
+  gtk_menu_shell_append (GTK_MENU_SHELL (menu), gtk_separator_menu_item_new ());
+
+  item = gtk_menu_item_new_with_label (_("Save current settings as preset…"));
+  g_signal_connect (item, "activate", G_CALLBACK (trd_preset_save), renamer_dialog);
+  gtk_menu_shell_append (GTK_MENU_SHELL (menu), item);
+
+  if (names->len > 0)
+    {
+      item = gtk_menu_item_new_with_label (_("Delete preset"));
+      sub = gtk_menu_new ();
+      gtk_menu_item_set_submenu (GTK_MENU_ITEM (item), sub);
+      for (n = 0; n < names->len; ++n)
+        {
+          GtkWidget *d = gtk_menu_item_new_with_label (g_ptr_array_index (names, n));
+          g_object_set_data_full (G_OBJECT (d), "preset-name", g_strdup (g_ptr_array_index (names, n)), g_free);
+          g_signal_connect (d, "activate", G_CALLBACK (trd_preset_delete), renamer_dialog);
+          gtk_menu_shell_append (GTK_MENU_SHELL (sub), d);
+        }
+      gtk_menu_shell_append (GTK_MENU_SHELL (menu), item);
+    }
+  g_ptr_array_free (names, TRUE);
+
+  gtk_widget_show_all (menu);
+  g_signal_connect_swapped (menu, "selection-done", G_CALLBACK (gtk_widget_destroy), menu);
+  gtk_menu_popup_at_widget (GTK_MENU (menu), button, GDK_GRAVITY_SOUTH_WEST, GDK_GRAVITY_NORTH_WEST, NULL);
+}
