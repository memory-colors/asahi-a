+/* Delete / KP_Delete removes the selected files from the list */
+static gboolean
+thunar_renamer_dialog_tree_key_press (GtkWidget           *tree_view,
+                                      GdkEventKey         *event,
+                                      ThunarRenamerDialog *renamer_dialog)
+{
+  if (event->keyval == GDK_KEY_Delete || event->keyval == GDK_KEY_KP_Delete)
+    return thunar_renamer_dialog_action_remove_files (renamer_dialog);
+  return FALSE;
+}
