+/*
+ * thunar_util_split_number_suffix
+ *
+ * Looks for a trailing " (N)" at the end of the first @stem_len bytes of @stem, N being a plain
+ * number of 1-3 digits without leading zeros (or "0"). On success @base_len is the length of the name
+ * in front of the " (N)" and @number is N; otherwise @base_len = @stem_len and @number = 0.
+ * Used so that a name clash with "file (5).ext" resolves to "file (6).ext", not "file (5) (1).ext".
+ */
+gboolean
+thunar_util_split_number_suffix (const gchar *stem,
+                                 gsize        stem_len,
+                                 gsize       *base_len,
+                                 guint       *number)
+{
+  gsize digits;
+  gsize i;
+  guint value = 0;
+
+  *base_len = stem_len;
+  *number = 0;
+
+  if (stem_len < 5 || stem[stem_len - 1] != ')')
+    return FALSE;
+
+  for (digits = 0; digits < 4 && digits + 2 < stem_len && g_ascii_isdigit (stem[stem_len - 2 - digits]); digits++)
+    ;
+  if (digits < 1 || digits > 3)
+    return FALSE;
+
+  i = stem_len - 1 - digits;                /* index of the first digit */
+  if (stem_len < digits + 4 || stem[i - 1] != '(' || stem[i - 2] != ' ')
+    return FALSE;
+  if (digits > 1 && stem[i] == '0')
+    return FALSE;
+
+  for (gsize k = 0; k < digits; k++)
+    value = value * 10 + (guint) (stem[i + k] - '0');
+
+  *base_len = i - 2;
+  *number = value;
+  return TRUE;
+}
