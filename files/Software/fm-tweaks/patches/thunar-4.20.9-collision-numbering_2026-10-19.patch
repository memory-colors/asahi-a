+/* the collision dialog's body text is 2 pt smaller than the normal text */
+static void
+thunar_dialog_label_shrink (GtkWidget *label,
+                            gint       points)
+{
+  PangoFontDescription *desc = NULL;
+  PangoAttrList        *attrs = pango_attr_list_new ();
+  GtkStyleContext      *context = gtk_widget_get_style_context (label);
+
+  gtk_style_context_get (context, gtk_style_context_get_state (context), "font", &desc, NULL);
+  if (desc != NULL && pango_font_description_get_size (desc) > points * PANGO_SCALE)
+    {
+      gint size = pango_font_description_get_size (desc) - points * PANGO_SCALE;
+      pango_attr_list_insert (attrs, pango_attr_size_new (size));
+      gtk_label_set_attributes (GTK_LABEL (label), attrs);
+    }
+  if (desc != NULL)
+    pango_font_description_free (desc);
+  pango_attr_list_unref (attrs);
+}
+
+
+
+static void
+thunar_dialog_label_smaller (GtkWidget *label)
+{
+  thunar_dialog_label_shrink (label, 2);
+}
+
+
+
+static void
+thunar_dialog_button_smaller (GtkWidget *button,
+                              gpointer   data)
+{
+  GtkWidget *child = gtk_bin_get_child (GTK_BIN (button));
+
+  if (GTK_IS_LABEL (child))
+    thunar_dialog_label_shrink (child, 1);
+}
