[Icon Theme]
Name=fm-folders
Comment=MacTahoe-nord-dark with every folder-ish icon forced to the generic folder (for Thunar/Nemo trials)
Inherits=MacTahoe-nord-dark
Directories=places/scalable,mimetypes,devices

[places/scalable]
Size=64
MinSize=16
MaxSize=512
Type=Scalable
Context=Places

[mimetypes]
Size=64
MinSize=16
MaxSize=512
Type=Scalable
Context=MimeTypes

[devices]
Size=64
MinSize=16
MaxSize=512
Type=Scalable
Context=Devices
