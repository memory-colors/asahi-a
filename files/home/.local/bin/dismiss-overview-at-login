#!/usr/bin/bash
# Fallback for the GNOME 50 "overview shows at startup" bug, in case the
# dash-to-panel patch (see linux_theming memory) doesn't hold. Waits a moment
# for the desktop to settle, then taps the Super key once - GNOME's standard
# behavior is a bare Super tap TOGGLES the overview, so this only works
# correctly as a fix if the overview is actually showing at that moment. If
# the real fix is working, this would incorrectly OPEN the overview instead
# - do not autostart this at the same time the real fix is expected to work,
# only as a deliberate replacement for it.
set -euo pipefail
sleep 1
YDOTOOL_SOCKET=/tmp/.ydotool_socket ydotool key 125:1 125:0
