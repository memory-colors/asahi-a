#!/bin/bash
# Always tile new Ptyxis windows right (same technique as the smplayer wrapper: ydotool types the real Alt+Super+Right tile-right shortcut,
# since Wayland apps cannot position themselves). Real binary: /usr/bin/ptyxis. exec keeps the PID GNOME tracks; the key press runs in a detached
# subshell started before exec. Only when a window is being opened (not --help / --preferences etc).
case " $* " in *" --help "*|*" --version "*|*" --preferences "*|*" --import-palette"*|*" --gapplication-service "*) exec /usr/bin/ptyxis "$@" ;; esac
(
    sleep 0.8
    YDOTOOL_SOCKET=/tmp/.ydotool_socket ydotool key 56:1 125:1 106:1 106:0 125:0 56:0 2>/dev/null || true
) &
disown
exec /usr/bin/ptyxis "$@"
