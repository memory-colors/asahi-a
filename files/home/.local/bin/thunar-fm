#!/bin/bash
# thunar-fm - launch Thunar with the fm-sample theme + fm-folders icon theme for THIS process only (private XDG_CONFIG_HOME farm; real config untouched).
C=$HOME/.config/fm-cfg
rm -rf "$C"; mkdir -p "$C/gtk-3.0" "$C/gtk-4.0" "$C/glib-2.0/settings"
for f in "$HOME"/.config/*; do case "$(basename "$f")" in gtk-3.0|gtk-4.0|glib-2.0|fm-cfg) ;; *) ln -s "$f" "$C/";; esac; done
for f in "$HOME"/.config/gtk-3.0/*; do case "$(basename "$f")" in settings.ini|gtk.css) ;; *) ln -s "$f" "$C/gtk-3.0/";; esac; done
sed '/KNOMADIC: gtk-inactive BEGIN/,/KNOMADIC: gtk-inactive END/d' "$HOME/.config/gtk-3.0/gtk.css" > "$C/gtk-3.0/global.css"   # the global "no colour change when inactive" block is for other GTK3 apps: Thunar keeps its own inactive rules
printf '@import url("file://%s/gtk-3.0/global.css");
@import url("file://%s/.themes/fm-sample/user.css");
' "$C" "$HOME" > "$C/gtk-3.0/gtk.css"   # user.css is GENERATED by fm-tweaks (templates/thunar-user.css.in)
for f in "$HOME"/.config/gtk-4.0/*; do case "$(basename "$f")" in gtk.css) ;; *) ln -s "$f" "$C/gtk-4.0/";; esac; done
printf '@import url("file://%s/.config/gtk-4.0/gtk.css");\n@import url("file://%s/.themes/fm-sample/gtk4.css");\n' "$HOME" "$HOME" > "$C/gtk-4.0/gtk.css"   # GTK4 dialogs opened by custom actions (zenity)
printf '[Settings]\ngtk-application-prefer-dark-theme=1\ngtk-icon-theme-name=fm-folders\ngtk-decoration-layout=close,minimize,maximize:\n' > "$C/gtk-3.0/settings.ini"
FN=$("$HOME/.themes/machine-setup/fm-font.sh" font --get 2>/dev/null); MN=$("$HOME/.themes/machine-setup/fm-font.sh" mono --get 2>/dev/null)   # Knomadic > Thunar font rows
printf "[org/gnome/desktop/interface]\nicon-theme='fm-folders'\ncolor-scheme='prefer-dark'\ncursor-theme='Bibata-Modern-Ice'\ncursor-size=22\nfont-name='${FN:-SF Pro Regular, 14}'\nmonospace-font-name='${MN:-Monospace 12}'\n\n[org/gnome/desktop/wm/preferences]\nbutton-layout='close,minimize,maximize:'\n" > "$C/glib-2.0/settings/keyfile"
dconf dump /org/gtk/settings/file-chooser/ 2>/dev/null | sed -e '1s|.*|\n[org/gtk/settings/file-chooser]|' -e '/^window-\(size\|position\)=/d' >> "$C/glib-2.0/settings/keyfile"; printf 'window-position=(24, 21)\nwindow-size=(823, 583)\n' >> "$C/glib-2.0/settings/keyfile"   # GTK file dialogs opened from custom actions (xarchiver) get the same size/columns as in the normal session (needs window-position AND window-size)
# private Thunar build (split view focuses the NEW pane: ~/Software/fm-tweaks/patches/thunar-4.20.2-split-focus-new-pane_*.patch); stock thunar if it is missing or built for another package version
TBIN=$HOME/.local/libexec/thunar-fm/thunar
[ -x "$TBIN" ] && [ "$(cat "$HOME/.local/libexec/thunar-fm/built-for-package-version" 2>/dev/null)" = "$(rpm -q --qf '%{VERSION}-%{RELEASE}' Thunar 2>/dev/null)" ] || TBIN=thunar
exec env LD_PRELOAD="$HOME/.themes/fm-sample/hooks.so${LD_PRELOAD:+:$LD_PRELOAD}" FONTCONFIG_FILE="$HOME/.config/fm-fonts/fonts.conf" XDG_CONFIG_HOME="$C" GSETTINGS_BACKEND=keyfile GTK_THEME=fm-sample "$TBIN" "$@"
