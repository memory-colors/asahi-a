#!/bin/bash
# Wrapper that opens gtk3-basic-bulk-renamer already tiled to the right half
# of the screen, via GNOME's native tiling (Mutter) triggered by a real
# simulated key event (ydotool) - the same technique used for SMPlayer's
# tile-right wrapper (~/.local/bin/smplayer), since native Wayland doesn't
# let client apps set their own window position/size.
#
# Key sequence must match GNOME's CURRENT toggle-tiled-right binding -
# check `gsettings get org.gnome.mutter.keybindings toggle-tiled-right`
# if this ever silently stops working (it moved from <Super>Right to
# <Alt><Super>Right previously - see linux_theming memory).

/home/blank/.local/bin/gtk3-basic-bulk-renamer &
APP_PID=$!

# Give the window time to actually map and take focus before tiling it.
sleep 0.8

YDOTOOL_SOCKET=/tmp/.ydotool_socket ydotool key 56:1 125:1 106:1 106:0 125:0 56:0 2>/dev/null || true

wait "$APP_PID"
