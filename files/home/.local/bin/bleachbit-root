#!/bin/bash
# Wrapper for launching BleachBit as root under Wayland (XWayland via X11
# protocol). Two things are needed together, or BleachBit's own root-side
# check (Unix.py: runs `xhost` AS ROOT and fails if it errors) reports
# "not allowed" regardless:
#   1. Grant root access to this X session (xhost).
#   2. pkexec strips DISPLAY/XAUTHORITY from root's environment by default -
#      without forwarding them explicitly, root's own `xhost` call has no
#      display to connect to at all, so it fails and BleachBit's check
#      trips even though xhost was granted correctly in step 1.
xhost +si:localuser:root >/dev/null 2>&1
pkexec env DISPLAY="$DISPLAY" XAUTHORITY="$XAUTHORITY" bleachbit
xhost -si:localuser:root >/dev/null 2>&1
