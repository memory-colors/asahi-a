 //______________________________________________________________
+// Dolphin's main file-list scrollbar (child of KItemListContainer): thinner strip, flat fill in the
+// active color scheme's View background (same source as Dolphin's list background).
+static bool isDolphinItemListScrollBar(const QWidget *w)
+{
+    for (int i = 0; w && i < 5; ++i, w = w->parentWidget()) {
+        if (w->inherits("KItemListContainer"))
+            return true;
+    }
+    return false;
+}
+// Dolphin view color = bluegrey.colors [Colors:View] BackgroundNormal - the exact section the
+// Knomadic "Dolphin view" row (dolphin-view-color.sh) edits, so the scrollbar strip always matches
+// the file list (read once per process; restart Dolphin after changing it).
+static QColor dolphinViewColor()
+{
+    static const QColor color = []() {
+        const QColor fallback(0x1e, 0x1e, 0x21);
+        QFile f(QDir::homePath() + QStringLiteral("/.local/share/color-schemes/bluegrey.colors"));
+        if (!f.open(QIODevice::ReadOnly | QIODevice::Text))
+            return fallback;
+        bool inView = false;
+        while (!f.atEnd()) {
+            const QString line = QString::fromUtf8(f.readLine()).trimmed();
+            if (line.startsWith(QLatin1Char('['))) {
+                inView = (line == QLatin1String("[Colors:View]"));
+            } else if (inView && line.startsWith(QLatin1String("BackgroundNormal="))) {
+                const QStringList rgb = line.mid(17).split(QLatin1Char(','));
+                if (rgb.size() >= 3)
+                    return QColor(rgb[0].toInt(), rgb[1].toInt(), rgb[2].toInt());
+            }
+        }
+        return fallback;
+    }();
+    return color;
+}
+
+// Dolphin path (breadcrumb) bar fill: ~/.themes/dolphin-theme/breeze-colors.conf, line `pathbar=#rrggbb`
+// (written by dolphin-pathbar-color.sh / the Knomadic row). Read once per process.
+static QColor dolphinPathBarColor()
+{
+    static const QColor color = []() {
+        const QColor fallback(0x1b, 0x1b, 0x1d);
+        QFile f(QDir::homePath() + QStringLiteral("/.themes/dolphin-theme/breeze-colors.conf"));
+        if (!f.open(QIODevice::ReadOnly | QIODevice::Text))
+            return fallback;
+        while (!f.atEnd()) {
+            const QString line = QString::fromUtf8(f.readLine()).trimmed();
+            if (line.startsWith(QLatin1String("pathbar="))) {
+                const QColor c(line.mid(8).trimmed());
+                if (c.isValid())
+                    return c;
+            }
+        }
+        return fallback;
+    }();
+    return color;
+}
