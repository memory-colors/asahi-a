/* kcolorchooser only (passed with -stylesheet by Knomadic and org.kde.kcolorchooser.desktop; NOT a global qt6ct stylesheet).
   Removes the 1px frames QColorDialog draws around the preview swatch and the colour pickers so colours can be compared.
   Verified 2026-10-09: this stops the PREVIEW frame. */
QColorDialog QFrame,
QColorShowLabel,
QColorPicker,
QColorLuminancePicker {
    border: none;
    border-width: 0px;
}
