/* SHARED look (templates/shared.qss.in): rounded context menus + tooltips + the Open With dialog, loaded per wrapped Qt app.
   GENERATED output - edit the template / fm-tweaks.conf, not this file. */
QMenu {
    background-color: #2c2c34;
    border: 1px solid #45454d;
    border-radius: 16px;
    padding: 4px;
}
QMenu::item {
    padding: 4px 22px 4px 10px;
    margin-left: 0px;
    border-radius: 8px;
    font-size: 16px;
}
/* KNOMADIC: noicons-menu-padding - menus_have_icons=false / the noicons LD_PRELOAD shim stop Qt from drawing menu icons,
   but Qt still reserves the icon column's width via the QMenu::icon subcontrol; collapse it so the left padding above
   is the only indent. Ported from the Debian 2026-10-10 no-icons work (undocumented there; documented here instead). */
QMenu::icon {
    width: 0px;
    padding: 0px;
}
QMenu::item:selected {
    background-color: #483676;
    selection-background-color: #483676;
    border: none;
    color: white;
}
QMenu::separator {
    height: 1px;
    margin: 4px 8px;
}
QToolTip {
    background-color: #2c2c34;
    border: 1px solid #3e3e46;
    border-radius: 16px;
    padding: 4px 8px;
    font-size: 16px;
}
KOpenWithDialog {
    background-color: #2c2c34;
}
KOpenWithDialog QTreeView {
    background-color: #2c2c34;
}

/* GENERATED by fm-tweaks (templates/smplayer.qss.in) -> <config>/smplayer/themes/PapirusDark/style.qss, appended after shared.qss.in.
   Every region of SMPlayer, mapped to ONE swatch (the groups are the point: lump / split them by editing the token on a line):
     menu     #2c2c34   menu bar, menu popups, combo popups, tooltips          (Knomadic: Menu)
     surface  #2c2c34    dialogs, dock title, toolbars + control rows, tab pages, group frames   (Knomadic: Panels)
     content  #161619      playlist body, preferences page list, log/text areas, lists
     field    #121215    table headers, text fields, combos, spin boxes, push buttons, scrollbar + slider grooves   (Knomadic: Button)
     accent   #483676    selection, default button, slider fill, checked tool buttons, focus
     status   #1c1c20 status bar (SMPlayer paints it black itself; this overrides)   text #4e4e5a
     text     #bdbfd2 / #bdbfd2 (headers, buttons) / #ffffff (on accent)
   Left alone on purpose: the video area (always black), the Information dialog's coloured HTML headings (hard-coded in SMPlayer). */
/* menu group */
QMenuBar { background-color: #2c2c34; color: #bdbfd2; }
QMenuBar::item { background: transparent; padding: 4px 8px; border-radius: 6px; }
QMenuBar::item:selected { background-color: #483676; color: #ffffff; }
/* surface group */
QDialog, QDockWidget, QToolBar, QStackedWidget { background-color: #2c2c34; color: #bdbfd2; }
QDockWidget::title { background-color: #2c2c34; padding: 4px 6px; }
QToolBar { border: none; spacing: 2px; }
QTabWidget::pane { background-color: #2c2c34; border: 1px solid #3e3e46; border-radius: 6px; }
QTabBar::tab { background: transparent; color: #bdbfd2; padding: 4px 10px; border-radius: 6px; margin: 2px; }
QTabBar::tab:selected { background-color: #483676; color: #ffffff; }
QTabBar::tab:hover:!selected { background-color: #121215; }
QGroupBox { border: 1px solid #3e3e46; border-radius: 8px; margin-top: 12px; padding-top: 6px; }
QGroupBox::title { subcontrol-origin: margin; left: 10px; padding: 0 4px; }
/* content group */
QListView, QListWidget, QTreeView, QTableView, QTextEdit, QPlainTextEdit, QTextBrowser { background-color: #161619; color: #bdbfd2; alternate-background-color: #161619; border: none; selection-background-color: #483676; selection-color: #ffffff; }
QListView::item:selected, QListWidget::item:selected, QTreeView::item:selected, QTableView::item:selected { background-color: #483676; color: #ffffff; border-radius: 6px; }
QListView::item:hover:!selected, QListWidget::item:hover:!selected, QTreeView::item:hover:!selected { background-color: #121215; border-radius: 6px; }
/* separator lines (Preferences): the patched Breeze paints them from bluegrey.colors, i.e. the GENERAL palette; draw them from the content swatch instead so SMPlayer stays independent */
QFrame[frameShape="4"], QFrame[frameShape="5"] { border: none; background-color: #161619; }
/* field group */
QHeaderView::section { background-color: #121215; color: #bdbfd2; border: none; padding: 1px 6px; min-height: 24px; max-height: 24px; }
QLineEdit, QAbstractSpinBox, QComboBox { background-color: #121215; color: #bdbfd2; border: 1px solid transparent; border-radius: 6px; padding: 3px 6px; selection-background-color: #483676; selection-color: #ffffff; }
QLineEdit:focus, QAbstractSpinBox:focus, QComboBox:focus { border: 1px solid #483676; }
QComboBox::drop-down { border: none; width: 20px; }
QComboBox::down-arrow { image: url(arrow-down.svg); width: 14px; height: 14px; }
QAbstractSpinBox::up-button, QAbstractSpinBox::down-button { border: none; width: 16px; background: transparent; }
QAbstractSpinBox::up-arrow { image: url(arrow-up.svg); width: 12px; height: 12px; }
QAbstractSpinBox::down-arrow { image: url(arrow-down.svg); width: 12px; height: 12px; }
QComboBox QAbstractView, QComboBox QAbstractItemView { background-color: #2c2c34; color: #bdbfd2; border: 1px solid #3e3e46; border-radius: 8px; selection-background-color: #483676; selection-color: #ffffff; outline: none; }
QPushButton, QToolButton { background-color: #121215; color: #bdbfd2; border: none; border-radius: 6px; padding: 4px 12px; }
QPushButton:hover, QToolButton:hover { background-color: #2c2c34; }
QPushButton:default { background-color: #483676; color: #ffffff; }
QPushButton:disabled, QToolButton:disabled { color: #77798c; }
QToolButton { padding: 3px; background: transparent; }
QToolButton:hover { background-color: #121215; }
QToolButton:checked, QToolButton:pressed { background-color: #483676; }
QToolButton::menu-indicator { image: none; width: 0; height: 0; }
QScrollBar:vertical { background: transparent; width: 10px; margin: 0; }
QScrollBar:horizontal { background: transparent; height: 10px; margin: 0; }
QScrollBar::handle { background-color: #121215; border-radius: 5px; min-height: 24px; min-width: 24px; }
QScrollBar::add-line, QScrollBar::sub-line { width: 0; height: 0; }
QScrollBar::add-page, QScrollBar::sub-page { background: transparent; }
QSlider::groove:horizontal { background-color: #121215; height: 4px; border-radius: 2px; }
QSlider::sub-page:horizontal { background-color: #483676; border-radius: 2px; }
QSlider::handle:horizontal { background-color: #bdbfd2; width: 12px; height: 12px; margin: -4px 0; border-radius: 6px; }
QProgressBar { background-color: #121215; border: none; border-radius: 5px; text-align: center; color: #bdbfd2; }
QProgressBar::chunk { background-color: #483676; border-radius: 5px; }
QCheckBox::indicator, QRadioButton::indicator { width: 16px; height: 16px; border-radius: 4px; background-color: #121215; }
QRadioButton::indicator { border-radius: 8px; }
QCheckBox::indicator:checked { background-color: #483676; image: url(check.svg); }
QRadioButton::indicator:checked { background-color: #483676; image: url(radio.svg); }
QCheckBox::indicator:disabled, QRadioButton::indicator:disabled { background-color: #2c2c34; }
/* status group */
QStatusBar { background-color: #1c1c20; color: #4e4e5a; }
QStatusBar QLabel, QStatusBar QToolButton { color: #4e4e5a; background: transparent; }
QStatusBar::item { border: none; }
